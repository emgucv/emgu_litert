<?xml version="1.0" encoding="utf-8" ?>
<!-- The whole chat is one control; MainPage.xaml.cs gives it the model. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chat="clr-namespace:Emgu.LiteRT.LM.Maui;assembly=Emgu.LiteRT.LM.Maui"
             x:Class="MauiChat.MainPage"
             Title="On-device chat"
             BackgroundColor="{AppThemeBinding Light=#EEF1F8, Dark=#11131A}">
    <chat:ChatView x:Name="Chat" Instructions="You are a helpful assistant. Keep your answers short." />
</ContentPage>
