<Project Sdk="Microsoft.NET.Sdk">

	<!--
	A minimal app with an on-device chat: one page with Emgu.LiteRT.LM.Maui's ChatView (MainPage.xaml), and App.xaml
	restyling its Send button and the user's messages by key. The target frameworks come from the CMake-generated
	Directory.Build.props (cmake/Emgu.LiteRT.MauiChat.Directory.Build.props.in).
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>MauiChat</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationTitle>LiteRT Chat</ApplicationTitle>
		<ApplicationId>com.emgu.litert.chat</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- LiteRT-LM needs iOS 26.4 at run time (its Gemma constraint library); the frameworks themselves iOS 15. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- The chat control, which brings Emgu.LiteRT.LM.Chat, Emgu.LiteRT.LM.Extensions.AI and the language models. -->
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Maui\Maui\Emgu.LiteRT.LM.Maui.csproj" />
		<!-- LiteRT-LM's native libraries: the LM add-on runtimes (each brings the base Emgu.LiteRT runtime). An app using
		     the packages references Emgu.LiteRT.LM.runtime.maui.android / .ios / .macos instead. -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="..\..\Emgu.LiteRT.Runtime\Maui\LM\Android\Emgu.LiteRT.LM.runtime.maui.android.csproj" />
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="..\..\Emgu.LiteRT.Runtime\Maui\LM\iOS\Emgu.LiteRT.LM.runtime.maui.ios.csproj" />
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.Runtime\Maui\LM\Mac\Emgu.LiteRT.LM.runtime.maui.macos.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>
</Project>
