    <PackageReference Include="Emgu.CV.UI" Version="4.9.0.5494" />
  </ItemGroup>

  <Import Project="..\..\Emgu.LiteRT.Tflite.Models\Emgu.TF.Lite.Models.Shared.projitems" Label="Shared" />

  <Import Project="..\..\Emgu.LiteRT.ImageIO\Emgu.LiteRT.ImageIO.Shared.projitems" Label="Shared" />

