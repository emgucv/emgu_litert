<?xml version="1.0" encoding="utf-8" ?>
<!--
  The demo's look for Emgu.LiteRT.LM.Maui's chat controls: the message, code block and thinking templates replaced by key
  (see the library's Themes/ChatStyles.xaml), with the demo's Inter fonts, its colours (Theme.cs) and its Material Symbols
  chevron. Merged in App.xaml. The chat page (LiteRtLmChatPage) is the library's ChatPage; its messages' Tag holds the
  page's data for them (UserMessageInfo, StreamingBubble); the user template binds the divider text in it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:chat="clr-namespace:Emgu.LiteRT.LM.Maui;assembly=Emgu.LiteRT.LM.Maui"
                    xmlns:lm="clr-namespace:Emgu.LiteRT.LM.Chat;assembly=Emgu.LiteRT.LM.Chat"
                    xmlns:ai="clr-namespace:Microsoft.Extensions.AI;assembly=Microsoft.Extensions.AI.Abstractions"
                    xmlns:local="clr-namespace:Maui.Demo.Lite"
                    x:Class="Maui.Demo.Lite.ChatTemplates">

    <local:AllTrueConverter x:Key="AllTrue" />

    <Style x:Key="ChatDecorationTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="TextColor" Value="#8A8FA3" />
    </Style>

    <DataTemplate x:Key="ChatUserMessageTemplate" x:DataType="lm:ChatMessageItem">
        <VerticalStackLayout Spacing="6">
            <!-- Where the model's memory of the chat starts; tap it to read the summary. -->
            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Margin="8,4" IsVisible="{Binding StartsContext}">
                <BoxView HeightRequest="1" Color="#C2C7D6" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Tag.DividerText, x:DataType={x:Null}}" FontFamily="InterRegular" FontSize="12"
                       TextColor="#8A8FA3" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#C2C7D6" VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type chat:ChatView}}, Path=ShowSummaryCommand, x:DataType=chat:ChatView}" />
                </Grid.GestureRecognizers>
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Attachments}" Spacing="6" HorizontalOptions="End"
                                 IsVisible="{Binding HasAttachments}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="ai:DataContent">
                        <chat:ChatAttachmentView Attachment="{Binding .}" HorizontalOptions="End" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <!-- The words of a voice message, written down by the speech recognizer (ChatView). -->
            <Label Text="{Binding Transcript, StringFormat='&#x201C;{0}&#x201D;'}" IsVisible="{Binding HasTranscript}"
                   FontFamily="InterRegular" FontSize="14" FontAttributes="Italic" TextColor="#8A8FA3"
                   HorizontalOptions="End" HorizontalTextAlignment="End" MaximumWidthRequest="420" />
            <Border HorizontalOptions="End" MaximumWidthRequest="420" Padding="12,9" Stroke="Transparent" BackgroundColor="#3D7BF7"
                    IsVisible="{Binding HasText}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <chat:SelectableLabel Text="{Binding Text}" TextColor="White" FontFamily="InterRegular" FontSize="15" />
            </Border>
            <!-- Copies the whole message (ChatView.CopyMessageCommand): a small icon; the text itself can be selected on Windows. -->
            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                  Fill="#8A8FA3" Aspect="Uniform" WidthRequest="14" HeightRequest="14"
                  IsVisible="{Binding HasText}" HorizontalOptions="End" Margin="0,0,10,0" SemanticProperties.Description="Copy this message">
                <Path.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type chat:ChatView}}, Path=CopyMessageCommand, x:DataType=chat:ChatView}"
                                          CommandParameter="{Binding .}" />
                </Path.GestureRecognizers>
            </Path>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Decorations}" IsVisible="{Binding HasDecorations}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <chat:ChatDecorationView Decoration="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </DataTemplate>

    <DataTemplate x:Key="ChatReplyTemplate" x:DataType="lm:ChatMessageItem">
        <VerticalStackLayout Spacing="10">
            <!-- The tool calls, then the cards they made (a picture, photo results, a device action...). -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="lm:ChatToolStep">
                        <Label Text="{Binding Text, StringFormat='&#x1F50E; {0}'}" FontFamily="InterRegular" FontSize="13"
                               TextColor="#8A8FA3" Margin="6,0" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <!-- The page's cards for the reply, and the document's step line. -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Decorations}" IsVisible="{Binding HasDecorations}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:Object">
                        <chat:ChatDecorationView Decoration="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Border x:Name="Bubble" HorizontalOptions="Start" MaximumWidthRequest="420" Padding="12,9" Stroke="Transparent"
                    BackgroundColor="#E8EFFE">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <!-- A reply with code may use the full width, so less of the code wraps. -->
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference Body}, Path=HasCode, x:DataType=chat:ReplyView}" Value="True">
                        <Setter Property="MaximumWidthRequest" Value="100000" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="4">
                    <chat:ThinkingView x:Name="Thinking" Thinking="{Binding Thinking}" IsThinking="{Binding IsThinking}"
                                       Duration="{Binding ThinkingDuration}" AlwaysExpanded="{Binding IsFinishedWithoutAnswer}"
                                       DisplayText="{Binding ThinkingDisplayText}"
                                       Accessory="{Binding ThinkingAccessory}" />
                    <BoxView HeightRequest="1" Color="#C2C7D6">
                        <BoxView.IsVisible>
                            <MultiBinding Converter="{StaticResource AllTrue}">
                                <Binding Source="{x:Reference Thinking}" Path="ShowsThinking" x:DataType="chat:ThinkingView" />
                                <Binding Path="HasAnswer" />
                            </MultiBinding>
                        </BoxView.IsVisible>
                    </BoxView>
                    <chat:ReplyView x:Name="Body" Text="{Binding Text}" IsVisible="{Binding HasAnswer}" FontFamily="InterRegular"
                                    FontSize="15" TextColor="#1A1C2E" LinkColor="#3D7BF7" SecondaryTextColor="#8A8FA3"
                                    QuoteMarkColor="#C2C7D6" />
                    <Label Text="…" IsVisible="{Binding IsInterrupted}" FontFamily="InterRegular" FontSize="15" TextColor="#8A8FA3" />
                    <Label Text="{Binding Error, StringFormat='Error: {0}'}" IsVisible="{Binding IsFailed}" FontFamily="InterRegular"
                           FontSize="14" TextColor="#D93B3B" />
                </VerticalStackLayout>
            </Border>
            <!-- Copies the reply's answer (ChatView.CopyMessageCommand), once it is written: a small icon; the text itself can be selected on Windows. -->
            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                  Fill="#8A8FA3" Aspect="Uniform" WidthRequest="14" HeightRequest="14"
                  IsVisible="{Binding CanCopy}" HorizontalOptions="Start" Margin="10,-4,0,0" SemanticProperties.Description="Copy this reply">
                <Path.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type chat:ChatView}}, Path=CopyMessageCommand, x:DataType=chat:ChatView}"
                                          CommandParameter="{Binding .}" />
                </Path.GestureRecognizers>
            </Path>
        </VerticalStackLayout>
    </DataTemplate>

    <ControlTemplate x:Key="CodeBlockViewTemplate">
        <Border BackgroundColor="#1F2430" Stroke="Transparent" Padding="10,6,10,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label x:Name="PART_Language" FontFamily="InterRegular" FontSize="12" TextColor="#9AA3B5" VerticalOptions="Center" />
                    <Label x:Name="PART_Copy" Grid.Column="1" Text="Copy" FontFamily="InterSemiBold" FontSize="12"
                           TextColor="#9AA3B5" Padding="8,2" HorizontalOptions="End" />
                </Grid>
                <Label x:Name="PART_Code" FontSize="13" TextColor="#E6E9F0" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ThinkingViewTemplate">
        <VerticalStackLayout Spacing="4">
            <Grid x:Name="PART_Header" ColumnSpacing="6" ColumnDefinitions="Auto,Auto,Auto">
                <ActivityIndicator x:Name="PART_Spinner" Color="#8A8FA3" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                <Label x:Name="PART_Title" Grid.Column="1" FontFamily="InterSemiBold" FontSize="13" TextColor="#8A8FA3" VerticalOptions="Center" />
                <!-- chevron_right; ThinkingView turns it a quarter turn (expand_more) while the thinking is shown. -->
                <Image x:Name="PART_Chevron" Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" HorizontalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialSymbols" Glyph="&#xE5CC;" Color="#8A8FA3" Size="16" />
                    </Image.Source>
                </Image>
            </Grid>
            <ContentView x:Name="PART_Accessory" />
            <Label x:Name="PART_Preview" FontFamily="InterRegular" FontSize="13" TextColor="#8A8FA3" />
            <chat:ReplyView x:Name="PART_Body" FontFamily="InterRegular" FontSize="13" TextColor="#8A8FA3" />
        </VerticalStackLayout>
    </ControlTemplate>
</ResourceDictionary>
