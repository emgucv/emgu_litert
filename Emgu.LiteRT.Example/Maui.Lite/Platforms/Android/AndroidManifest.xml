<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- usesCleartextTraffic: "Your own server" (LM Studio, Ollama...) is usually plain http:// on the local network, at an address the user types. -->
	<application android:usesCleartextTraffic="true" android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">
		<!-- LiteRT-LM chat on the GPU: LiteRT's OpenCL accelerator (libLiteRtOpenClAccelerator.so) loads the device's
		     OpenCL driver, which Android 12+ only lets apps load when declared. Optional: without it the chat uses the CPU. -->
		<uses-native-library android:name="libOpenCL.so" android:required="false" />
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.BATTERY_STATS" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- User-requested model transfers continue with the screen off; the service owns its wake lock. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Taking photos (MediaPicker.CapturePhotoAsync): the image demos and the LiteRT-LM chat -->
	<uses-permission android:name="android.permission.CAMERA" />
	<!-- LiteRT-LM chat: voice messages -->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<!-- LiteRT-LM chat: "Share my location" (the agent's location tool; city-level accuracy is enough, and Android
	     lets the user choose approximate) -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-feature android:name="android.hardware.location" android:required="false" />
	<!-- LiteRT-LM chat: "Search my photos" (the agent's find_photos tool reads the photo library to index it on the
	     device): READ_MEDIA_IMAGES on Android 13+, READ_MEDIA_VISUAL_USER_SELECTED when the user allows only some photos
	     (Android 14+), READ_EXTERNAL_STORAGE before Android 13 -->
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
	<uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<!-- Photo search: where photos were taken (Android 10+ removes their GPS position for apps without it). Optional. -->
	<uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
	<!-- LiteRT-LM chat: device actions - timers and alarms in the clock app (AlarmClock intents), once the user confirms -->
	<uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
	<!-- LiteRT-LM chat: reading replies aloud (TextToSpeech, Android 11+ package visibility) -->
	<queries>
		<intent>
			<action android:name="android.intent.action.TTS_SERVICE" />
		</intent>
		<!-- Taking photos with the device's camera app (MediaPicker.CapturePhotoAsync, Android 11+ package visibility) -->
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
		<!-- Device actions: the clock app (timers, alarms) and the calendar app (a new event, filled in) -->
		<intent>
			<action android:name="android.intent.action.SET_TIMER" />
		</intent>
		<intent>
			<action android:name="android.intent.action.SET_ALARM" />
		</intent>
		<intent>
			<action android:name="android.intent.action.INSERT" />
			<data android:mimeType="vnd.android.cursor.dir/event" />
		</intent>
	</queries>
</manifest>
