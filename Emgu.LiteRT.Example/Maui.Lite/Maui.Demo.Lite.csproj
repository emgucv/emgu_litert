<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>Emgu.TF.Lite.Maui.Demo</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Display name -->
		<ApplicationTitle>Emgu LiteRT</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.emgu.litert</ApplicationId>
		<ApplicationIdGuid>f725d173-ae14-4a50-a033-127ffb80d906</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<Import Project="MacCatalyst.Signing.props" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and Exists('MacCatalyst.Signing.props')" />

	<!-- Keychain entitlements require a matching Mac Catalyst provisioning profile. Keep ordinary ad-hoc builds
	     runnable; they report session-only API keys. Pass CodesignKey and CodesignProvision for persistence. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(CodesignProvision)' != ''">
		<EnableCodeSigning>true</EnableCodeSigning>
		<CodesignEntitlements Condition="'$(CodesignEntitlements)' == ''">Platforms/MacCatalyst/Keychain.entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- iOS: compile ahead of time in Debug too, without Mono's interpreter (which Debug builds otherwise use for hot
	     reload). In the interpreter, image generation (Z-Image-Turbo through Emgu.LiteRT) crashed at the start of a
	     second picture - an ArrayTypeMismatchException, and once that was worked around a SIGSEGV in
	     mono_interp_exec_method - while the same code compiled ahead of time draws picture after picture. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<UseInterpreter>false</UseInterpreter>
	</PropertyGroup>

	<!--
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup>
	-->
	
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#3D7BF7" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#3D7BF7" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- Sample audio for the LiteRT-LM chat page's attachments, from the LiteRT-LM submodule. -->
		<MauiAsset Include="..\..\LiteRT-LM\support\preprocessor\testdata\audio_sample.wav" LogicalName="audio_sample.wav" Condition="Exists('..\..\LiteRT-LM\support\preprocessor\testdata\audio_sample.wav')" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Raw\dog416.png" />
	  <None Remove="Resources\Raw\space_shuttle.jpg" />
	  <None Remove="Resources\Raw\surfers.jpg" />
	  <None Remove="Resources\Raw\tulips.jpg" />
	</ItemGroup>


	<ItemGroup>
		<ProjectReference Include="..\..\Emgu.LiteRT.Runtime\Maui\UI\Emgu.LiteRT.runtime.maui.csproj" />
	    <ProjectReference Include="..\..\Emgu.TF.Lite\NetStandard\Emgu.TF.Lite.csproj" />
	  
	    <!-- <ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="..\..\Emgu.TF.Lite.Models\Emgu.TF.Lite.Models.IOS\Emgu.TF.Lite.Models.IOS.csproj" /> -->
	    <!-- <ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="..\..\Emgu.TF.Lite.Models\Emgu.TF.Lite.Models.Android\Emgu.TF.Lite.Models.Android.csproj" /> -->
	    <!-- <ProjectReference Condition="!($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android')" Include="..\..\Emgu.TF.Lite.Models\Emgu.TF.Lite.Models.Netstandard\Emgu.TF.Lite.Models.Netstandard.csproj" /> -->
		
		<ProjectReference Include="..\..\Emgu.TF.Lite.Models\NetStandard\Emgu.TF.Lite.Models.csproj" />

		<!-- LiteRT-LM chat demo (LiteRtLmChatPage.cs), on Windows, iOS and Android: LiteRT-LM's native library isn't
		     bundled with this app on Mac Catalyst yet (on iOS it comes from the LiteRtLm.xcframework the iOS LiteRT-LM
		     add-on embeds, built by platforms/ios/bazel_build_litert_lm_ios; on Android from liblitert-lm.so, arm64-v8a
		     and x86_64 only, which the Android MAUI runtime packages). -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.LM\NetStandard\Emgu.LiteRT.LM.csproj" />
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.LM.Models\NetStandard\Emgu.LiteRT.LM.Models.csproj" />
		<!-- The chat page's web search: a Microsoft Agent Framework agent over the model's IChatClient. -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.LM.Extensions.AI\NetStandard\Emgu.LiteRT.LM.Extensions.AI.csproj" />
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.LM.Agents\NetStandard\Emgu.LiteRT.LM.Agents.csproj" />
		<!-- The chat page's image generation (LiteRtLmChatPage.Images.cs): Z-Image-Turbo on LiteRT's CompiledModel API. -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.Models\NetStandard\Emgu.LiteRT.Models.csproj" />
		<PackageReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="Microsoft.Agents.AI" Version="1.24.0" />
		<!-- Native Save As dialogs for generated pictures; 13.0.0 supports the existing MAUI 10.0.11 version. -->
		<PackageReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="CommunityToolkit.Maui.Core" Version="13.0.0" />
		<!-- The chat page's saved chats (ChatStore.cs): SQLite. -->
		<PackageReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="sqlite-net-pcl" Version="1.11.285" />
		<!-- The chat page's documents (DocumentReader.cs): text and pictures of PDF files. -->
		<PackageReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="PdfPig" Version="0.1.16" />
		<!-- On Android, iOS and Mac Catalyst, LiteRT-LM's native library comes from the separate LiteRT-LM add-on
		     runtimes (the base Emgu.LiteRT.runtime.maui.android/.ios/.macos only carry tfliteextern/libLiteRt):
		     liblitert-lm.so and libGemmaModelConstraintProvider.so on Android, LiteRtLm.xcframework and
		     GemmaModelConstraintProvider.xcframework on iOS, and on Mac Catalyst the macOS liblitert-lm.dylib (with
		     libGemmaModelConstraintProvider.dylib and libLiteRt.dylib), loaded from the app bundle. -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="..\..\Emgu.LiteRT.Runtime\Maui\LM\Android\Emgu.LiteRT.LM.runtime.maui.android.csproj" />
		<!-- Optional: LiteRT's GPU (OpenCL) accelerator, so the chat can run Gemma 4 on the GPU (Settings, "Use the GPU");
		     needs the libOpenCL.so <uses-native-library> in Platforms/Android/AndroidManifest.xml. -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="..\..\Emgu.LiteRT.Runtime\Maui\OpenCL\Android\Emgu.LiteRT.OpenCL.runtime.maui.android.csproj" />
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="..\..\Emgu.LiteRT.Runtime\Maui\LM\iOS\Emgu.LiteRT.LM.runtime.maui.ios.csproj" />
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.Runtime\Maui\LM\Mac\Emgu.LiteRT.LM.runtime.maui.macos.csproj" />
		<!-- Optional: LiteRT's GPU (Metal) accelerator, so the chat can run Gemma 4 on the Mac's GPU (Settings, "Use the GPU"). -->
		<ProjectReference Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\..\Emgu.LiteRT.Runtime\Maui\Metal\Mac\Emgu.LiteRT.Metal.runtime.maui.macos.csproj" />

		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Emgu.CV.runtime.maui.mini" Version="4.12.0.5764" />
		<!--
		Emgu.CV.Models (pulled in by Emgu.CV.runtime.maui.mini) has no Android target, so Android resolves its
		netstandard2.0 dependency on System.Drawing.Common. That package's Windows-only System.Private.Windows.Core.dll
		crashes Mono's AOT compiler (it references System.Formats.Nrbf, absent on Android), failing the Android Release
		build - and on iOS every AOT build (Release, or Debug without the interpreter): "Failed to AOT compile
		System.Private.Windows.Core.dll ... exited with code 139". Exclude the package's assets on Android and iOS;
		nothing here uses it there. Emgu.CV.Models dropped the dependency
		upstream (emgucv EMGUCV_5_0, commit a2309f10c), so this can go once the demo uses an Emgu CV release with that fix.
		-->
		<PackageReference Include="System.Drawing.Common" Version="9.0.0" ExcludeAssets="all" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
	</ItemGroup>
	
	<Import Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" Project="..\..\Emgu.LiteRT.Runtime\Windows\Emgu.TF.Lite.Runtime.Windows.projitems" Label="Shared" />
	
	<ItemGroup>
	  <PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
	</ItemGroup>

	<!-- Mac Catalyst: the Metal add-on (Emgu.LiteRT.Metal.runtime.maui.macos) references the LiteRT-LM add-on, which
	     this project references too, so liblitert-lm.dylib, libLiteRt.dylib and libGemmaModelConstraintProvider.dylib
	     reach the app twice, and the SDK's install_name_tool runs on each copy at once - a clean build failed with
	     "cannot rename ... .tmp" (incremental builds skip that step). Keep one of each. -->
	<Target Name="EmguRemoveDuplicateNativeReferences" BeforeTargets="_ComputeDynamicLibrariesToReidentify" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<RemoveDuplicates Inputs="@(_FileNativeReference)">
			<Output TaskParameter="Filtered" ItemName="_EmguUniqueFileNativeReference" />
		</RemoveDuplicates>
		<ItemGroup>
			<_FileNativeReference Remove="@(_FileNativeReference)" />
			<_FileNativeReference Include="@(_EmguUniqueFileNativeReference)" />
		</ItemGroup>
	</Target>
    <Import Project="WindowsGpu.targets" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
</Project>
