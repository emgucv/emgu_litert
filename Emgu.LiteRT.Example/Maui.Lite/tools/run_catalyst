#!/bin/bash
# Build the Mac Catalyst demo without a provisioning profile, make it launchable and start it.
#
# The default build signs with the team's identity and a provisioning profile (for the keychain entitlement); when that
# identity has expired ("MacCatalyst code signing key ... not found in keychain") use this instead. It signs ad hoc with an
# empty entitlements file, so the API keys are kept for the session only (see the csproj). On macOS 27 such an app was killed
# at launch ("Code Signature Invalid", in dyld, while mapping a dependent library): the universal libLiteRt.dylib /
# liblitert-lm.dylib in MonoBundle - their x86_64 slices are no longer valid after the SDK's install_name_tool step - so
# this script copies the app to a folder on the internal disk, keeps only the arm64 slice of every universal dylib and
# signs each dylib and the app ad hoc again.
#
#   run_catalyst [destination folder] [ENV=value ...]     (the app is started with the environment given, e.g. EMGU_LM_SELFTEST=1)
set -e
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../../.." && pwd)"
dest="${1:-$HOME/emgu_litert_catalyst}"
shift || true
entitlements="$(mktemp -d)/empty.entitlements.plist"
printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict/></plist>\n' > "$entitlements"
cd "$root"
dotnet build Emgu.LiteRT.Example/Maui.Lite/Maui.Demo.Lite.csproj -f net10.0-maccatalyst -c Debug -p:ValidateXcodeVersion=false \
    -p:CodesignKey=- -p:CodesignProvision= -p:CodesignEntitlements="$entitlements"
src="$root/Emgu.LiteRT.Example/Maui.Lite/bin/Debug/net10.0-maccatalyst/maccatalyst-arm64/Emgu LiteRT.app"
app="$dest/Emgu LiteRT.app"
mkdir -p "$dest"
[ -e "$app" ] && mv "$app" "$app.old.$$" && rm -rf "$app.old.$$"
ditto "$src" "$app"
for f in "$app"/Contents/MonoBundle/*.dylib; do
    if lipo -info "$f" 2>/dev/null | grep -q "Architectures in the fat file"; then
        lipo "$f" -thin arm64 -output "$f.thin" && mv "$f.thin" "$f"
    fi
    codesign --force -s - "$f" > /dev/null
done
codesign --force --deep -s - "$app" > /dev/null
codesign --verify --deep --strict "$app"
echo "Starting $app"
# Started directly (not with `open`), so that the environment reaches the app.
nohup env "$@" "$app/Contents/MacOS/Maui.Demo.Lite" > "$dest/last_run.log" 2>&1 &
disown
