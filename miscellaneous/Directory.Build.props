<?xml version="1.0" encoding="utf-8"?>
<!-- Properties shared between Emgu.LiteRT.html.shfbproj and Emgu.LiteRT.OpenXml.shfbproj.
     Despite being old-style (non-SDK) SHFB projects, both still pick this up automatically:
     SandcastleHelpFileBuilder.targets (which each project imports) transitively imports
     Microsoft.Common.props, which performs the standard directory-walk-up Directory.Build.props
     auto-import. No explicit <Import> is needed in - or should be added to - either project. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- The configuration and platform will be used to determine which
         assemblies to include from solution and project documentation
         sources -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <SHFBSchemaVersion>2017.9.26.0</SHFBSchemaVersion>
    <!-- AssemblyName, Name, and RootNamespace are not used by SHFB but Visual
         Studio adds them anyway -->
    <AssemblyName>Documentation</AssemblyName>
    <RootNamespace>Documentation</RootNamespace>
    <Name>Documentation</Name>
    <!-- SHFB properties -->
    <OutputPath>..\Help\</OutputPath>
    <HtmlHelpName>Emgu.TF.Lite.Documentation</HtmlHelpName>
    <ProjectSummary>Emgu TF Lite is a cross platform .Net wrapper for the Google Tensorflow Lite library. Allows Tensorflow Lite functions to be called from .NET compatible languages such as C#, VB, VC++, IronPython.</ProjectSummary>
    <MissingTags>Summary, Parameter, Returns, AutoDocumentCtors, Namespace, TypeParameter</MissingTags>
    <VisibleItems>InheritedMembers, InheritedFrameworkMembers, Protected, SealedProtected, EditorBrowsableNever, NonBrowsable</VisibleItems>
    <HtmlHelp1xCompilerPath>
    </HtmlHelp1xCompilerPath>
    <HtmlHelp2xCompilerPath>
    </HtmlHelp2xCompilerPath>
    <SandcastlePath>%DXROOT%</SandcastlePath>
    <WorkingPath>
    </WorkingPath>
    <KeepLogFile>False</KeepLogFile>
    <BuildLogFile>
    </BuildLogFile>
    <CppCommentsFixup>False</CppCommentsFixup>
    <FrameworkVersion>.NET Core/.NET Standard/.NET 5.0+</FrameworkVersion>
    <HelpTitle>Emgu TF Lite Library Documentation</HelpTitle>
    <CopyrightText>$([System.DateTime]::Now.ToString(yyyy)) Emgu Corporation, All Rights Reserved,</CopyrightText>
    <FeedbackEMailAddress>support%40emgu.com</FeedbackEMailAddress>
    <HeaderText>https://www.emgu.com</HeaderText>
    <FooterText>For questions and discussions please visit https://github.com/emgucv/emgutf/issues</FooterText>
    <DocumentationSources>
      <DocumentationSource sourceFile="..\Solution\Windows.Desktop\Emgu.LiteRT.sln" />
    </DocumentationSources>
    <NamespaceSummaries>
      <NamespaceSummaryItem name="(global)" isDocumented="True">Emgu LiteRT is a cross platform .Net wrapper for Google's LiteRT and TensorFlow Lite libraries. Allows LiteRT and TensorFlow Lite functions to be called from .NET compatible languages such as C#, VB, VC++, IronPython.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu" isDocumented="True">Root namespace for class and functions implemented by Emgu Corporation</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.TF.Lite" isDocumented="True">Managed wrapper (Interpreter, Tensor, TfLiteInvoke) over the TensorFlow Lite C API, exposed through the tfliteextern native library.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.TF.Lite.Models" isDocumented="True">High-level pre-built model helpers (MobileNet, COCO SSD, etc.) that download weights and run inference, built on the Emgu.TF.Lite Interpreter API.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.TF.Lite.ImageIO" isDocumented="True">Image loading helpers (NativeImageIO, JpegData) for decoding images into tensors.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.LiteRT" isDocumented="True">Managed wrapper (Model, CompiledModel, Environment, TensorBuffer) over LiteRT's own libLiteRt C API.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.LiteRT.Util" isDocumented="True">Base classes (UnmanagedObject, DisposableObject) and shared utilities (Annotation, DownloadableFile, FileDownloadManager) used across the Emgu LiteRT libraries.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.LiteRT.LM" isDocumented="True">Managed wrapper (EngineSettings, Engine, Session, Conversation) over LiteRT-LM's C API for running on-device language models.</NamespaceSummaryItem>
<NamespaceSummaryItem name="Emgu.LiteRT.LM.Models" isDocumented="True">Ready-to-use language models (Qwen3, Gemma4E2B, Gemma4E4B) and chat helpers (Chat, ChatMessage, ChatAttachment) built on Emgu.LiteRT.LM.</NamespaceSummaryItem></NamespaceSummaries>
    <PlugInConfigurations>
    </PlugInConfigurations>
    <MaximumGroupParts>2</MaximumGroupParts>
    <NamespaceGrouping>False</NamespaceGrouping>
    <SyntaxFilters>Standard</SyntaxFilters>
    <SdkLinkTarget>Blank</SdkLinkTarget>
    <RootNamespaceContainer>True</RootNamespaceContainer>
    <Preliminary>False</Preliminary>
    <NamingMethod>Guid</NamingMethod>
    <Language>en-US</Language>
    <FeedbackEMailLinkText>support%40emgu.com</FeedbackEMailLinkText>
    <ContentPlacement>AboveNamespaces</ContentPlacement>
    <BuildAssemblerVerbosity>OnlyWarningsAndErrors</BuildAssemblerVerbosity>
    <IndentHtml>False</IndentHtml>
    <DisableCodeBlockComponent>False</DisableCodeBlockComponent>
    <CleanIntermediates>True</CleanIntermediates>
    <SaveComponentCacheCapacity>100</SaveComponentCacheCapacity>
  </PropertyGroup>
</Project>
