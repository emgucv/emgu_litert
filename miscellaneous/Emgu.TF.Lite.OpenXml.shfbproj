<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated SHFB project for the OpenXml (Word) documentation output - see
     Emgu.TF.Lite.html.shfbproj and Directory.Build.props for why this is a separate project
     file rather than a build-time override of Emgu.TF.Lite.html.shfbproj. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="14.0">
  <!-- Properties shared with Emgu.TF.Lite.html.shfbproj live in Directory.Build.props.
       SHFB's own SandcastleHelpFileBuilder.targets (imported below) transitively imports
       Microsoft.Common.props, which auto-imports Directory.Build.props from this same folder -
       no explicit <Import> needed here (adding one causes a duplicate-import warning, since the
       automatic one still runs afterwards and finds it already loaded). -->
  <PropertyGroup>
    <ProjectGuid>{9b6e2f41-7c3a-4d8e-a1f0-5c2d8e6b3a9f}</ProjectGuid>
    <HelpFileFormat>OpenXml</HelpFileFormat>
    <PresentationStyle>OpenXml</PresentationStyle>
  </PropertyGroup>
  <!-- There are no properties for these two groups but they need to appear in
       order for Visual Studio to perform the build. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
  </PropertyGroup>
  <!-- Import the SHFB build targets -->
  <Import Project="$(SHFBROOT)\SandcastleHelpFileBuilder.targets" />
</Project>
