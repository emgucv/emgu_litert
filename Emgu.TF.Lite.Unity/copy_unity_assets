#!/bin/sh
cd "$(dirname "$0")"

cd Assets
cd Emgu.TF.Lite
mkdir -p Assets
cd Assets
mkdir -p Scripts
cd Scripts

rm -rf Emgu.LiteRT.Util
mkdir -p Emgu.LiteRT.Util
rm -rf Emgu.TF.Lite
mkdir -p Emgu.TF.Lite
rm -rf Emgu.TF.Lite.ImageIO
mkdir -p Emgu.TF.Lite.ImageIO
rm -rf Emgu.TF.Lite.Models
mkdir -p Emgu.TF.Lite.Models

cd ..
cd ..
cd ..
cd ..

cp ../litert/third_party/tensorflow/LICENSE Assets/Emgu.TF.Lite/Documentation/tensorflow.license.txt
#cp unityStoreIcons/README.txt Assets/Emgu.TF/README.txt

cp ../Emgu.LiteRT.Util/*.cs Assets/Emgu.TF.Lite/Assets/Scripts/Emgu.LiteRT.Util/
cp ../Emgu.TF.Lite/*.cs Assets/Emgu.TF.Lite/Assets/Scripts/Emgu.TF.Lite/
cp ../Emgu.TF.Lite.ImageIO/*.cs Assets/Emgu.TF.Lite/Assets/Scripts/Emgu.TF.Lite.ImageIO/
cp ../Emgu.TF.Lite.Models/*.cs Assets/Emgu.TF.Lite/Assets/Scripts/Emgu.TF.Lite.Models/

# iOS: the dynamic xcframeworks platforms/ios/bazel_build_xcframework builds (tfliteextern links LiteRt). Their .meta
# files make them iOS-only plug-ins with "Add to Embedded Binaries", so Unity links them into UnityFramework, where
# DllImport("__Internal") resolves, and embeds them in the app (Unity 6).
mkdir -p Assets/Emgu.TF.Lite/Plugins/iOS
for f in tfliteextern LiteRt
do
    if test -d "../lib/ios/$f.xcframework"
    then
        rm -rf "Assets/Emgu.TF.Lite/Plugins/iOS/$f.xcframework"
        cp -R "../lib/ios/$f.xcframework" Assets/Emgu.TF.Lite/Plugins/iOS/
    else
        echo "../lib/ios/$f.xcframework not found: run platforms/ios/bazel_build_xcframework for iOS"
    fi
done

# macOS: the universal dylibs platforms/macos/bazel_build_macos_fat builds; libtfliteextern.dylib finds libLiteRt.dylib
# beside it (@loader_path). Their .meta files make them plug-ins for the macOS player and the editor on macOS.
mkdir -p Assets/Emgu.TF.Lite/Plugins/macOS
for f in libtfliteextern libLiteRt
do
    if test -f "../lib/runtimes/osx/native/$f.dylib"
    then
        cp -f "../lib/runtimes/osx/native/$f.dylib" Assets/Emgu.TF.Lite/Plugins/macOS/
    else
        echo "../lib/runtimes/osx/native/$f.dylib not found: run platforms/macos/bazel_build_macos_fat for macOS"
    fi
done

# Android: libtfliteextern.so and the libLiteRt.so it links, per ABI, from platforms/android/bazel_build_litert. Their .meta
# files set each pair's CPU; Unity's Android build needs IL2CPP for arm64 and x86_64.
for abi in arm64-v8a armeabi-v7a x86 x86_64
do
    mkdir -p Assets/Emgu.TF.Lite/Plugins/Android/libs/$abi
    for f in libtfliteextern libLiteRt
    do
        if test -f "../lib/android/$abi/$f.so"
        then
            cp -f "../lib/android/$abi/$f.so" Assets/Emgu.TF.Lite/Plugins/Android/libs/$abi/
        else
            echo "../lib/android/$abi/$f.so not found: run platforms/android/bazel_build_litert for $abi"
        fi
    done
done
