/Assets/Emgu.TF.Lite/Plugins/macOS/*.dylib
/Assets/Emgu.TF.Lite/Documentation/tensorflow.license.txt
/Assets/Emgu.TF.Lite/Demo/Resources/*.png
/Assets/Emgu.TF.Lite/Demo/EmguTFLogo.png
