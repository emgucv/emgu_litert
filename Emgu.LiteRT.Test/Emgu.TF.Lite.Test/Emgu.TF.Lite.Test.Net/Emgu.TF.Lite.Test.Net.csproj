         generated from cmake/Emgu.TF.Lite.Test.Net.Directory.Build.props.in. -->

    <IsPackable>false</IsPackable>
    <!-- Opt in to the model-downloading tests (UnitTestLiteRtLm) with
         dotnet test -p:TestModels=true -->
