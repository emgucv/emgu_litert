#!/bin/bash -v

if command -v python3.12 >/dev/null 2>&1; then
    export HERMETIC_PYTHON_VERSION=3.12
fi

if [[ $# -lt 1 ]]; then
    BAZEL_CPU=darwin
	BAZEL_OPTIONS=
else
    BAZEL_CPU=$1
	BAZEL_OPTIONS=${@:2}
fi
cd "$(dirname "$0")"
cd ../../
# Keep Bazel's output tree (its --output_user_root startup option) in a subfolder of this repo rather than
# the default /private/var/tmp/_bazel_$USER (macOS) or ~/.cache/bazel (Linux). It sits outside the LiteRT-LM/
# workspace on purpose, so Bazel never treats it as source.
BAZEL_OUTPUT_USER_ROOT="$(pwd)/bazel_output"
mkdir -p lib/runtimes/osx/native

# If Xcode is installed outside /Applications (e.g. on a separate volume),
# Bazel's sandbox won't mount it by default — add it explicitly.
XCODE_DEVELOPER_DIR="$(xcode-select -p 2>/dev/null)"
XCODE_MOUNT_POINT=""
if [ -n "$XCODE_DEVELOPER_DIR" ]; then
    case "$XCODE_DEVELOPER_DIR" in
        /Volumes/*)
            XCODE_MOUNT_POINT="$(echo "$XCODE_DEVELOPER_DIR" | cut -d/ -f1-3)"
            ;;
    esac
fi

BAZEL_XCODE_OPTS=""
if [ -n "$XCODE_MOUNT_POINT" ] && [ "$XCODE_MOUNT_POINT" != "/" ]; then
    echo "Xcode is on non-root volume: $XCODE_MOUNT_POINT — setting BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1 and DEVELOPER_DIR"
    export BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1
    export DEVELOPER_DIR="$XCODE_DEVELOPER_DIR"
    APPLE_SDK_VERSION=$(xcrun --sdk macosx --show-sdk-version 2>/dev/null)
    BAZEL_XCODE_OPTS="--action_env=DEVELOPER_DIR=$XCODE_DEVELOPER_DIR --action_env=APPLE_SDK_VERSION_OVERRIDE=$APPLE_SDK_VERSION --action_env=APPLE_SDK_PLATFORM=MacOSX"
fi

# Build in the LiteRT-LM submodule's Bazel workspace, against the LiteRT it pins (its WORKSPACE fetches LiteRT as
# the external repository @litert), so that libLiteRt.dylib comes from the same LiteRT source as LiteRT-LM's
# liblitert-lm.dylib and one copy can serve both. LiteRT-LM is a pristine third-party submodule (we don't
# own/patch it upstream), so the tfliteextern Bazel package can't live there in git: stage our tracked source
# into it here instead, each run. Our BUILD file is written for the litert workspace, where LiteRT's packages are
# local (//tflite/..., //litert/...); rewrite those labels to @litert//... while staging.
WORKSPACE_DIR=LiteRT-LM
mkdir -p $WORKSPACE_DIR/tfliteextern
sed -e 's#"//tflite#"@litert//tflite#g' -e 's#"//litert#"@litert//litert#g' \
    litertextern/tfliteextern/bazel/BUILD > $WORKSPACE_DIR/tfliteextern/BUILD || exit 1
cp -f litertextern/tfliteextern/bazel/tfliteextern.def $WORKSPACE_DIR/tfliteextern/tfliteextern.def
cp -f litertextern/tfliteextern/bazel/litert_exported_symbols_darwin.lds $WORKSPACE_DIR/tfliteextern/litert_exported_symbols_darwin.lds
cp -f litertextern/tfliteextern/tfliteextern.cc $WORKSPACE_DIR/tfliteextern/tfliteextern.cc
cp -f litertextern/tfliteextern/tfliteextern.h $WORKSPACE_DIR/tfliteextern/tfliteextern.h
cp -f litertextern/imgproc/imgproc.cc $WORKSPACE_DIR/tfliteextern/imgproc.cc
cp -f litertextern/imgproc/imgproc.h $WORKSPACE_DIR/tfliteextern/imgproc.h

cd $WORKSPACE_DIR

# LiteRT-LM's .bazelrc (like litert's) auto-applies build:macos via --enable_platform_specific_config on
# this host, but --config=macos is passed explicitly for clarity, same as
# platforms/windows/bazel_build_litert.ps1 does for --config=windows.
BAZEL_CONFIG_FLAGS="--config=macos"
if [ "$BAZEL_CPU" = "darwin_arm64" ]; then
    BAZEL_CONFIG_FLAGS="$BAZEL_CONFIG_FLAGS --config=macos_arm64"
else
    # --cpu alone isn't enough to cross-compile x86_64 from an arm64 host: it changes the
    # compiler's target arch, but select()s on @platforms//cpu:x86_64 (e.g. litert's
    # tflite/kernels/internal:x86_any, which pulls in @arm_neon_2_x86_sse for NEON_2_SSE.h)
    # still see the host's arm64 platform and silently drop those deps. Set the target
    # platform explicitly, mirroring what litert's own build:macos_arm64 config does.
    BAZEL_CONFIG_FLAGS="$BAZEL_CONFIG_FLAGS --cpu=$BAZEL_CPU --platforms=@build_bazel_apple_support//platforms:macos_x86_64"
fi

# liblitert-lm.dylib (LiteRT-LM's C API) is built for arm64 only: it needs LiteRT-LM's prebuilt
# libGemmaModelConstraintProvider.dylib, which only exists for macOS arm64 (prebuilt/macos_arm64, stored with Git LFS).
BUILD_LITERT_LM=0
if [ "$BAZEL_CPU" = "darwin_arm64" ]; then
    BUILD_LITERT_LM=1
    GEMMA_PREBUILT=prebuilt/macos_arm64/libGemmaModelConstraintProvider.dylib
    if ! file "$GEMMA_PREBUILT" | grep -q Mach-O; then
        echo "$WORKSPACE_DIR/$GEMMA_PREBUILT is not a Mach-O library (a Git LFS pointer?) - run 'git -C $WORKSPACE_DIR lfs pull'"
        exit 1
    fi
fi

# Bazel's bazel-bin symlink follows the most recent build, so each build's outputs are copied right after it.
# copy_dylib <bazel-bin relative path> <destination>: copies a built dylib out of bazel-bin, sets its install name
# to @rpath/<file name>, and drops every rpath except @loader_path (Bazel adds rpaths into its own _solib/runfiles
# output folders), since all of these dylibs are deployed side by side.
copy_dylib() {
    local SRC=$WORKSPACE_DIR/bazel-bin/$1
    local OUT=$2
    rm -f $OUT
    cp -f $SRC $OUT || exit 1
    chmod u+w $OUT
    install_name_tool -id "@rpath/$(basename $SRC)" $OUT
    for RPATH in $(otool -l $OUT | awk '/cmd LC_RPATH/ {getline; getline; print $2}'); do
        if [ "$RPATH" != "@loader_path" ]; then
            install_name_tool -delete_rpath "$RPATH" $OUT
        fi
    done
    # install_name_tool invalidates the signature, which arm64 requires - re-sign ad hoc.
    codesign -f -s - $OUT
    chmod u-w $OUT
}

if [ "$BUILD_LITERT_LM" = "1" ]; then
    # --define=litert_runtime_link_mode=dynamic makes liblitert-lm.dylib link against @rpath/libLiteRt.dylib instead
    # of containing LiteRT's runtime; the libLiteRt.dylib built below (same LiteRT source) is deployed next to it in
    # place of the LiteRt*-only one this build produces. TFLite's kernels and XNNPACK stay inside liblitert-lm.dylib:
    # its embedding code calls them through TFLite's C++ API, which libLiteRt.dylib doesn't export.
    # The define can't apply to the tfliteextern build: in dynamic mode LiteRT's C API libraries resolve to headers
    # only, so libLiteRt.dylib would be built empty. It also isn't part of Bazel's output folder name, so
    # --platform_suffix keeps this build's outputs apart instead of the two builds overwriting each other's.
    bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" build --verbose_failures -c opt $BAZEL_CONFIG_FLAGS $BAZEL_XCODE_OPTS --define=litert_runtime_link_mode=dynamic --platform_suffix=-litert_lm_dynamic $BAZEL_OPTIONS //c:litert-lm || exit 1
    cd ..
    copy_dylib c/liblitert-lm.dylib lib/runtimes/osx/native/liblitert-lm-$BAZEL_CPU.dylib
    rm -f lib/runtimes/osx/native/libGemmaModelConstraintProvider.dylib
    cp -f $WORKSPACE_DIR/$GEMMA_PREBUILT lib/runtimes/osx/native/libGemmaModelConstraintProvider.dylib || exit 1
    cd $WORKSPACE_DIR
fi

# libtfliteextern.dylib only contains the C API wrapper and links dynamically against libLiteRt.dylib (LiteRT's
# own runtime, exporting the LiteRt* and TfLite* C APIs) - see the macOS section of
# litertextern/tfliteextern/bazel/BUILD. Both are built per architecture here, then lipo'd below.
bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" build --verbose_failures -c opt $BAZEL_CONFIG_FLAGS $BAZEL_XCODE_OPTS $BAZEL_OPTIONS //tfliteextern:litert_runtime //tfliteextern:tfliteextern_dylib || exit 1

# Record the TFLite version - TensorFlow's TF_VERSION, from the TensorFlow source Bazel built against - next to the
# libraries. The top level CMakeLists.txt reads it to version the Emgu.TF.Lite, Emgu.LiteRT.Tflite.Models and Emgu.TF.Lite.runtime.windows nuget packages.
TF_VERSION_BZL="$(bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" info output_base)/external/org_tensorflow/tensorflow/tf_version.bzl"
TFLITE_VERSION=$(sed -n 's/^TF_VERSION = "\([0-9][0-9.]*\)".*/\1/p' "$TF_VERSION_BZL")
if [ -n "$TFLITE_VERSION" ]; then
    echo $TFLITE_VERSION > ../lib/runtimes/osx/native/tflite_version.txt
else
    echo "Warning: could not read TF_VERSION from $TF_VERSION_BZL; ../lib/runtimes/osx/native/tflite_version.txt not written"
fi

cd ..

for LIB in libtfliteextern libLiteRt; do
    copy_dylib tfliteextern/$LIB.dylib lib/runtimes/osx/native/$LIB-$BAZEL_CPU.dylib
done

#make fat binary
cd lib/runtimes/osx/native
# The previous fat binaries are read-only (bazel-bin outputs are), and lipo refuses to
# overwrite them - remove them first. liblitert-lm.dylib only ever has the arm64 slice (see above).
for LIB in libtfliteextern libLiteRt liblitert-lm; do
    if ls $LIB-*.dylib >/dev/null 2>&1; then
        rm -f $LIB.dylib
        lipo -create -output $LIB.dylib $LIB-*.dylib || exit 1
    fi
done
cd ../../../../
