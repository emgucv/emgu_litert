#!/bin/bash -v

if command -v python3.12 >/dev/null 2>&1; then
    export HERMETIC_PYTHON_VERSION=3.12
fi

if [[ $# -lt 1 ]]; then
    BAZEL_CPU=darwin
	BAZEL_OPTIONS=
else
    BAZEL_CPU=$1
	BAZEL_OPTIONS=${@:2}
fi
cd "$(dirname "$0")"
cd ../../
# Keep Bazel's output tree (its --output_user_root startup option) in a subfolder of this repo rather than
# the default /private/var/tmp/_bazel_$USER (macOS) or ~/.cache/bazel (Linux). It sits outside the litert/
# workspace on purpose, so Bazel never treats it as source.
BAZEL_OUTPUT_USER_ROOT="$(pwd)/bazel_output"
mkdir -p lib/runtimes/osx/native

# If Xcode is installed outside /Applications (e.g. on a separate volume),
# Bazel's sandbox won't mount it by default — add it explicitly.
XCODE_DEVELOPER_DIR="$(xcode-select -p 2>/dev/null)"
XCODE_MOUNT_POINT=""
if [ -n "$XCODE_DEVELOPER_DIR" ]; then
    case "$XCODE_DEVELOPER_DIR" in
        /Volumes/*)
            XCODE_MOUNT_POINT="$(echo "$XCODE_DEVELOPER_DIR" | cut -d/ -f1-3)"
            ;;
    esac
fi

BAZEL_XCODE_OPTS=""
if [ -n "$XCODE_MOUNT_POINT" ] && [ "$XCODE_MOUNT_POINT" != "/" ]; then
    echo "Xcode is on non-root volume: $XCODE_MOUNT_POINT — setting BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1 and DEVELOPER_DIR"
    export BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1
    export DEVELOPER_DIR="$XCODE_DEVELOPER_DIR"
    APPLE_SDK_VERSION=$(xcrun --sdk macosx --show-sdk-version 2>/dev/null)
    BAZEL_XCODE_OPTS="--action_env=DEVELOPER_DIR=$XCODE_DEVELOPER_DIR --action_env=APPLE_SDK_VERSION_OVERRIDE=$APPLE_SDK_VERSION --action_env=APPLE_SDK_PLATFORM=MacOSX"
fi

# litert is a pristine third-party submodule (we don't own/patch it upstream), so the
# tfliteextern Bazel package can't live there in git. Stage our tracked source into it
# here instead, each run, mirroring what litertextern/tfliteextern/CMakeLists.txt does
# for the CMake path without needing a copy step.
mkdir -p litert/tfliteextern
cp -f litertextern/tfliteextern/bazel/BUILD litert/tfliteextern/BUILD
cp -f litertextern/tfliteextern/bazel/tfliteextern.def litert/tfliteextern/tfliteextern.def
cp -f litertextern/tfliteextern/bazel/litert_exported_symbols_darwin.lds litert/tfliteextern/litert_exported_symbols_darwin.lds
cp -f litertextern/tfliteextern/tfliteextern.cc litert/tfliteextern/tfliteextern.cc
cp -f litertextern/tfliteextern/tfliteextern.h litert/tfliteextern/tfliteextern.h
cp -f litertextern/imgproc/imgproc.cc litert/tfliteextern/imgproc.cc
cp -f litertextern/imgproc/imgproc.h litert/tfliteextern/imgproc.h

cd litert

# litert's .bazelrc auto-applies build:macos via --enable_platform_specific_config on
# this host, but --config=macos is passed explicitly for clarity, same as
# platforms/windows/bazel_build_litert.ps1 does for --config=windows.
BAZEL_CONFIG_FLAGS="--config=macos"
if [ "$BAZEL_CPU" = "darwin_arm64" ]; then
    BAZEL_CONFIG_FLAGS="$BAZEL_CONFIG_FLAGS --config=macos_arm64"
else
    # --cpu alone isn't enough to cross-compile x86_64 from an arm64 host: it changes the
    # compiler's target arch, but select()s on @platforms//cpu:x86_64 (e.g. litert's
    # tflite/kernels/internal:x86_any, which pulls in @arm_neon_2_x86_sse for NEON_2_SSE.h)
    # still see the host's arm64 platform and silently drop those deps. Set the target
    # platform explicitly, mirroring what litert's own build:macos_arm64 config does.
    BAZEL_CONFIG_FLAGS="$BAZEL_CONFIG_FLAGS --cpu=$BAZEL_CPU --platforms=@build_bazel_apple_support//platforms:macos_x86_64"
fi

# libtfliteextern.dylib only contains the C API wrapper and links dynamically against libLiteRt.dylib (LiteRT's
# own runtime, exporting the LiteRt* and TfLite* C APIs) - see the macOS section of
# litertextern/tfliteextern/bazel/BUILD. Both are built per architecture here, then lipo'd below.
bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" build --verbose_failures -c opt $BAZEL_CONFIG_FLAGS $BAZEL_XCODE_OPTS $BAZEL_OPTIONS //tfliteextern:litert_runtime //tfliteextern:tfliteextern_dylib || exit 1

cd ..

for LIB in libtfliteextern libLiteRt; do
    OUT=lib/runtimes/osx/native/$LIB-$BAZEL_CPU.dylib
    rm -f $OUT
    cp -f litert/bazel-bin/tfliteextern/$LIB.dylib $OUT || exit 1
    chmod u+w $OUT
    # The install names (@rpath/<lib>.dylib) are set at link time. Bazel also adds rpaths into its own
    # _solib/runfiles output folders; drop everything except @loader_path, where the two dylibs are deployed.
    for RPATH in $(otool -l $OUT | awk '/cmd LC_RPATH/ {getline; getline; print $2}'); do
        if [ "$RPATH" != "@loader_path" ]; then
            install_name_tool -delete_rpath "$RPATH" $OUT
        fi
    done
    # install_name_tool invalidates the signature, which arm64 requires - re-sign ad hoc.
    codesign -f -s - $OUT
    chmod u-w $OUT
done

#make fat binary
cd lib/runtimes/osx/native
# The previous fat binaries are read-only (bazel-bin outputs are), and lipo refuses to
# overwrite them - remove them first.
for LIB in libtfliteextern libLiteRt; do
    rm -f $LIB.dylib
    lipo -create -output $LIB.dylib $LIB-*.dylib
done
cd ../../../../
