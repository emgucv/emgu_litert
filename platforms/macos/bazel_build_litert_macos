#!/bin/bash -v

if command -v python3.12 >/dev/null 2>&1; then
    export HERMETIC_PYTHON_VERSION=3.12
fi

# Builds LiteRT's own runtime library, libLiteRt.dylib (//litert/c:litert_runtime_c_api_dylib),
# straight from the litert submodule - no Emgu code is staged into or linked into it. It
# exports only the LiteRt* C API (plus kLiteRtRuntimeBuiltin), which the C# side P/Invokes
# directly via DllImport("LiteRt"); it is independent of libtfliteextern.dylib.
#
# Unlike bazel_build_tflite_macos (a plain cc_binary built once per --cpu then lipo'd),
# this target is a rules_apple macos_dylib, so --macos_cpus builds a universal
# arm64+x86_64 binary in a single invocation. Its install name is already
# @rpath/libLiteRt.dylib, so no install_name_tool step is needed.
#
# Any extra args are passed through to bazel (e.g. --macos_cpus=arm64 for a host-only build).
BAZEL_OPTIONS=$@

cd "$(dirname "$0")"
cd ../../
mkdir -p lib/runtimes/osx/native

# If Xcode is installed outside /Applications (e.g. on a separate volume),
# Bazel's sandbox won't mount it by default — add it explicitly.
XCODE_DEVELOPER_DIR="$(xcode-select -p 2>/dev/null)"
XCODE_MOUNT_POINT=""
if [ -n "$XCODE_DEVELOPER_DIR" ]; then
    case "$XCODE_DEVELOPER_DIR" in
        /Volumes/*)
            XCODE_MOUNT_POINT="$(echo "$XCODE_DEVELOPER_DIR" | cut -d/ -f1-3)"
            ;;
    esac
fi

BAZEL_XCODE_OPTS=""
if [ -n "$XCODE_MOUNT_POINT" ] && [ "$XCODE_MOUNT_POINT" != "/" ]; then
    echo "Xcode is on non-root volume: $XCODE_MOUNT_POINT — setting BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1 and DEVELOPER_DIR"
    export BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1
    export DEVELOPER_DIR="$XCODE_DEVELOPER_DIR"
    APPLE_SDK_VERSION=$(xcrun --sdk macosx --show-sdk-version 2>/dev/null)
    BAZEL_XCODE_OPTS="--action_env=DEVELOPER_DIR=$XCODE_DEVELOPER_DIR --action_env=APPLE_SDK_VERSION_OVERRIDE=$APPLE_SDK_VERSION --action_env=APPLE_SDK_PLATFORM=MacOSX"
fi

cd litert
bazel build --verbose_failures -c opt --config=macos --macos_cpus=arm64,x86_64 $BAZEL_XCODE_OPTS $BAZEL_OPTIONS //litert/c:litert_runtime_c_api_dylib || exit 1
cd ..

rm -f lib/runtimes/osx/native/libLiteRt.dylib
cp -f litert/bazel-bin/litert/c/libLiteRt.dylib lib/runtimes/osx/native/libLiteRt.dylib
