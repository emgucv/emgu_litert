#!/bin/bash -v

SYSTEM_ARCH=$(getconf LONG_BIT)
echo System is $SYSTEM_ARCH bit

if [ $SYSTEM_ARCH == "64" ]; then
    OUT_FOLDER="runtimes/linux-arm64/native"
    # LiteRT-LM's .bazelrc only adds arch-specific copts (-march=armv8-a etc.) via
    # linux_arm64 on top of the generic linux config; there's no separate "native
    # 64-bit ARM host" config, so this is the same pair the Ubuntu aarch64 build
    # script passes.
    BAZEL_CONFIG_FLAGS="--config=linux --config=linux_arm64"
else
    OUT_FOLDER="runtimes/linux-arm/native"
    # LiteRT-LM's .bazelrc has no native 32-bit ARM config - only android_arm (NDK
    # cross-toolchain) and elinux_armhf (an embedded cross-toolchain that isn't
    # defined in this WORKSPACE, see CLAUDE.md's Android toolchain-resolution
    # note for the same class of issue). Neither applies to a native build on
    # armhf hardware: with no --platforms/--crosstool_top override, Bazel
    # autoconfigures local_config_cc from the host's own gcc, which already
    # targets armhf here, so plain --config=linux is enough (same reasoning as
    # the x86_64/aarch64 case needing no extra flags beyond their own config).
    BAZEL_CONFIG_FLAGS="--config=linux"
fi

echo Output folder is $OUT_FOLDER

cd "$(dirname "$0")"
cd ../../..
mkdir -p lib/$OUT_FOLDER

# LiteRT-LM is a pristine third-party submodule (we don't own/patch it upstream), so the tfliteextern Bazel
# package can't live there in git. Stage our tracked source into it here instead, each run, mirroring what the
# Windows/macOS/iOS/Android/Ubuntu Bazel build scripts do. Build in the LiteRT-LM submodule's workspace, against
# the LiteRT it pins (its WORKSPACE fetches LiteRT as the external repository @litert), so libLiteRt.so comes from
# the same LiteRT source as LiteRT-LM's own runtime. Our BUILD file is written for the litert workspace, where
# LiteRT's packages are local; rewrite those labels to @litert//...
WORKSPACE_DIR=LiteRT-LM
mkdir -p $WORKSPACE_DIR/tfliteextern
sed -e 's#"//tflite#"@litert//tflite#g' -e 's#"//litert#"@litert//litert#g' \
    litertextern/tfliteextern/bazel/BUILD > $WORKSPACE_DIR/tfliteextern/BUILD || exit 1
cp -f litertextern/tfliteextern/bazel/tfliteextern.def $WORKSPACE_DIR/tfliteextern/tfliteextern.def
cp -f litertextern/tfliteextern/bazel/litert_exported_symbols_linux.lds $WORKSPACE_DIR/tfliteextern/litert_exported_symbols_linux.lds
cp -f litertextern/tfliteextern/tfliteextern.cc $WORKSPACE_DIR/tfliteextern/tfliteextern.cc
cp -f litertextern/tfliteextern/tfliteextern.h $WORKSPACE_DIR/tfliteextern/tfliteextern.h
cp -f litertextern/imgproc/imgproc.cc $WORKSPACE_DIR/tfliteextern/imgproc.cc
cp -f litertextern/imgproc/imgproc.h $WORKSPACE_DIR/tfliteextern/imgproc.h

cd $WORKSPACE_DIR

# LiteRT-LM's .bazelrc auto-applies build:linux via --enable_platform_specific_config on this
# host, but --config=linux is passed explicitly for clarity, same as the other platforms'
# Bazel build scripts do for their own host config.
#
# Force clang instead of the default gcc toolchain: tflite/kernels/internal/optimized/4bit/
# neon_fully_connected_{aarch64,arm32}_sdot.cc use __attribute__((target("dotprod"))) (no
# leading '+'), which gcc >=14 (Debian trixie's default) hard-errors on ("arch extension
# 'dotprod' should be prefixed by '+'") - verified on real arm64 hardware. clang accepts the
# bare form. This file lives inside LiteRT, which we don't patch, so the toolchain is
# swapped instead. --repo_env (not just an env var) is required so Bazel's
# autoconfigured local_config_cc repository picks it up.
# libtfliteextern.so links dynamically against libLiteRt.so (LiteRT's runtime, also used directly by
# Emgu.LiteRT) - see the "macOS and Android" section of litertextern/tfliteextern/bazel/BUILD.
bazel build --verbose_failures -c opt $BAZEL_CONFIG_FLAGS --repo_env=CC=/usr/bin/clang --repo_env=CXX=/usr/bin/clang++ "${@:1}" //tfliteextern:litert_runtime_so //tfliteextern:tfliteextern_so || exit 1

# Record the TFLite version - TensorFlow's TF_VERSION, from the TensorFlow source Bazel built against - next to the
# libraries. The top level CMakeLists.txt reads it to version the Emgu.TF.Lite/Emgu.LiteRT.Tflite.* nuget packages.
TF_VERSION_BZL="$(bazel info output_base)/external/org_tensorflow/tensorflow/tf_version.bzl"
TFLITE_VERSION=$(sed -n 's/^TF_VERSION = "\([0-9][0-9.]*\)".*/\1/p' "$TF_VERSION_BZL")
if [ -n "$TFLITE_VERSION" ]; then
    echo $TFLITE_VERSION > ../lib/$OUT_FOLDER/tflite_version.txt
else
    echo "Warning: could not read TF_VERSION from $TF_VERSION_BZL; ../lib/$OUT_FOLDER/tflite_version.txt not written"
fi

cd ..

for LIB in libtfliteextern libLiteRt; do
    cp -f $WORKSPACE_DIR/bazel-bin/tfliteextern/$LIB.so lib/$OUT_FOLDER/$LIB.so
done

echo Files copied to lib/$OUT_FOLDER
