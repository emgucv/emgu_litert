#!/bin/bash -v
set -e

SYSTEM_ARCH=$(getconf LONG_BIT)
echo System is $SYSTEM_ARCH bit

if [ $SYSTEM_ARCH == "64" ]
then
    OUT_FOLDER="runtimes/linux-arm64/native"
    CMAKE_XNN_FLAGS=-DTFLITE_ENABLE_XNNPACK:BOOL=ON
    EXTRA_CMAKE_FLAGS=
    JOB_COUNT=2
else
    OUT_FOLDER="runtimes/linux-arm/native"
    CMAKE_XNN_FLAGS=-DTFLITE_ENABLE_XNNPACK:BOOL=OFF
    #EXTRA_CMAKE_FLAGS=-DCMAKE_C_FLAGS="-mfloat-abi=soft"
    #EXTRA_CMAKE_FLAGS=-DXNNPACK_TARGET_PROCESSOR=arm
    # uname -m reports aarch64 on this 64-bit-kernel/32-bit-userland worker, so
    # CMAKE_SYSTEM_PROCESSOR (uname-based) misleads cpuinfo's CMakeLists.txt into
    # compiling src/arm/linux/aarch64-isa.c against headers built for the real,
    # 32-bit compiler target - fails with "struct cpuinfo_arm_isa has no member
    # named 'sme_f16f16'" etc. Passing -DCMAKE_SYSTEM_PROCESSOR alone is silently
    # ignored by CMake for a native (non-cross) build - it always re-derives the
    # value from uname at the first project()/enable_language() call. CMake only
    # honors an explicit CMAKE_SYSTEM_PROCESSOR once CMAKE_SYSTEM_NAME is also set,
    # which is the standard (if slightly heavy-handed) way to fix this exact
    # Raspberry-Pi-32-on-64-bit-kernel mismatch. This does flip
    # CMAKE_CROSSCOMPILING to TRUE for the whole configure even though we're not
    # really cross-compiling.
    EXTRA_CMAKE_FLAGS="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_SYSTEM_PROCESSOR=armv7l"
    JOB_COUNT=1
fi
echo Compiled binary will be placed in lib/$OUT_FOLDER

cd "$(dirname "$0")"
cd ../../..
REPO_ROOT=$(pwd)

if [ $SYSTEM_ARCH != "64" ]
then
    # Forcing CMAKE_SYSTEM_NAME above puts the whole configure into cross-compiling
    # mode, which makes litert/tflite/CMakeLists.txt refuse to build without a
    # natively-runnable flatc (it can't assume a "cross-compiled" one would run on
    # the host, even though here host and target are the same machine). Build one
    # via LiteRT's own native_tools/flatbuffers helper project - documented in
    # litert/tflite/g3doc/guide/build_cmake.md - and point TFLITE_HOST_TOOLS_DIR at
    # it. Rebuilt fresh every run since it lives inside the git-cleaned checkout,
    # but it's a small, fast build (just flatc, no tensorflow/xnnpack involved).
    rm -rf "$REPO_ROOT/flatc-native-build"
    cmake -S "$REPO_ROOT/litert/tflite/tools/cmake/native_tools/flatbuffers" -B "$REPO_ROOT/flatc-native-build"
    cmake --build "$REPO_ROOT/flatc-native-build"
    FLATC_DIR="$REPO_ROOT/flatc-native-build/flatbuffers-flatc/src/flatbuffers-flatc-build"
    EXTRA_CMAKE_FLAGS="$EXTRA_CMAKE_FLAGS -DTFLITE_HOST_TOOLS_DIR=$FLATC_DIR"
fi

# litertextern/tfliteextern's CMakeLists.txt links directly against litert/tflite (the
# google-ai-edge/LiteRT submodule) - there is no tensorflow/ submodule to build from
# anymore. It auto-detects linux-arm vs linux-arm64 from the compiler's predefined
# __arm__/__aarch64__ macros and writes libtfliteextern.so straight into lib/$OUT_FOLDER
# itself, so no copy step is needed here (matching the Windows CMake build script).
cd litertextern/tfliteextern
mkdir -p build
cd build

cmake $CMAKE_XNN_FLAGS $EXTRA_CMAKE_FLAGS ..    #-DCMAKE_VERBOSE_MAKEFILE=ON
cmake --build . --config Release --parallel $JOB_COUNT

echo Output written to lib/$OUT_FOLDER
