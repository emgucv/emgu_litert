+bool IsHostBitmapLogitMask(const LogitMask& mask) {
+  if (mask.GetType() != MaskType::kBitmap) {
+    return false;
+  }
+  // The vtable of a BitmapLogitMask made here; one made by another binary has
+  // its own (the type_info names are equal, so they cannot tell them apart).
+  static const void* const host_vtable = [] {
+    std::unique_ptr<BitmapLogitMask> probe = BitmapLogitMask::CreateAllAllowed(64);
+    return *reinterpret_cast<const void* const*>(probe.get());
+  }();
+  return *reinterpret_cast<const void* const*>(&mask) == host_vtable;
+}
