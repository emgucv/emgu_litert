#!/bin/bash -v

SYSTEM_ARCH=$(uname -m)
echo System is $SYSTEM_ARCH

if [ $SYSTEM_ARCH == "x86_64" ]; then
    OUT_FOLDER="runtimes/ubuntu-x64/native"
    BAZEL_CONFIG_FLAGS="--config=linux"
elif [ $SYSTEM_ARCH == "aarch64" ]; then
    OUT_FOLDER="runtimes/ubuntu-arm64/native"
    BAZEL_CONFIG_FLAGS="--config=linux --config=linux_arm64"
else
    echo "Unsupported architecture: $SYSTEM_ARCH"
    exit 1
fi

echo Output folder is $OUT_FOLDER

# Compile with clang, as LiteRT's own Linux CI does. Newer GCC (e.g. GCC 15 on Ubuntu 26.04) rejects some of
# LiteRT's sources, such as tflite/kernels/internal/optimized/4bit/neon_fully_connected_aarch64_sdot.cc's
# __attribute__((target("dotprod"))) on arm64 ("arch extension 'dotprod' should be prefixed by '+'").
if command -v clang >/dev/null 2>&1 && command -v clang++ >/dev/null 2>&1; then
    BAZEL_CONFIG_FLAGS="$BAZEL_CONFIG_FLAGS --repo_env=CC=clang --repo_env=CXX=clang++"
else
    echo "clang not found - building with the default compiler (install clang if the build fails, e.g. sudo apt install clang)"
fi

# LiteRT applies the XNNPACK delegate by default unless the build passes
# --define tflite_with_xnnpack=false, so follow whatever define was passed in.
TFLITE_WITH_XNNPACK=true
for arg in "$@"; do
    case "$arg" in
        *tflite_with_xnnpack=false) TFLITE_WITH_XNNPACK=false ;;
        *tflite_with_xnnpack=true) TFLITE_WITH_XNNPACK=true ;;
    esac
done
echo tflite_with_xnnpack is $TFLITE_WITH_XNNPACK

cd "$(dirname "$0")"
cd ../../..
mkdir -p lib/$OUT_FOLDER

# LiteRT-LM is a pristine third-party submodule (we don't own/patch it upstream), so the tfliteextern Bazel
# package can't live there in git. Stage our tracked source into it here instead, each run. Build in the
# LiteRT-LM submodule's workspace, against the LiteRT it pins (its WORKSPACE fetches LiteRT as the external
# repository @litert), so libLiteRt.so comes from the same LiteRT source as LiteRT-LM's own runtime. Our BUILD
# file is written for the litert workspace, where LiteRT's packages are local; rewrite those labels to @litert//...
WORKSPACE_DIR=LiteRT-LM
mkdir -p $WORKSPACE_DIR/tfliteextern
sed -e 's#"//tflite#"@litert//tflite#g' -e 's#"//litert#"@litert//litert#g' \
    litertextern/tfliteextern/bazel/BUILD > $WORKSPACE_DIR/tfliteextern/BUILD || exit 1
cp -f litertextern/tfliteextern/bazel/tfliteextern.def $WORKSPACE_DIR/tfliteextern/tfliteextern.def
cp -f litertextern/tfliteextern/bazel/litert_exported_symbols_linux.lds $WORKSPACE_DIR/tfliteextern/litert_exported_symbols_linux.lds
cp -f litertextern/tfliteextern/tfliteextern.cc $WORKSPACE_DIR/tfliteextern/tfliteextern.cc
cp -f litertextern/tfliteextern/tfliteextern.h $WORKSPACE_DIR/tfliteextern/tfliteextern.h
cp -f litertextern/imgproc/imgproc.cc $WORKSPACE_DIR/tfliteextern/imgproc.cc
cp -f litertextern/imgproc/imgproc.h $WORKSPACE_DIR/tfliteextern/imgproc.h

cd $WORKSPACE_DIR

# LiteRT-LM's .bazelrc auto-applies build:linux via --enable_platform_specific_config on this
# host, but --config=linux is passed explicitly for clarity, same as the other platforms'
# Bazel build scripts do for their own host config.
bazel build --verbose_failures -c opt $BAZEL_CONFIG_FLAGS "${@:1}" //tfliteextern:litert_runtime_so //tfliteextern:tfliteextern_so || exit 1

# Record the TFLite version - TensorFlow's TF_VERSION, from the TensorFlow source Bazel built against - next to the
# libraries. The top level CMakeLists.txt reads it to version the Emgu.LiteRT.Tflite* nuget packages.
TF_VERSION_BZL="$(bazel info output_base)/external/org_tensorflow/tensorflow/tf_version.bzl"
TFLITE_VERSION=$(sed -n 's/^TF_VERSION = "\([0-9][0-9.]*\)".*/\1/p' "$TF_VERSION_BZL")
if [ -n "$TFLITE_VERSION" ]; then
    echo $TFLITE_VERSION > ../lib/$OUT_FOLDER/tflite_version.txt
else
    echo "Warning: could not read TF_VERSION from $TF_VERSION_BZL; ../lib/$OUT_FOLDER/tflite_version.txt not written"
fi

cd ..

cp -f $WORKSPACE_DIR/bazel-bin/tfliteextern/libLiteRt.so lib/$OUT_FOLDER/libLiteRt.so
cp -f $WORKSPACE_DIR/bazel-bin/tfliteextern/libtfliteextern.so lib/$OUT_FOLDER/libtfliteextern.so
# Strip debug info; --strip-unneeded keeps the dynamic symbol table, so the exported functions are unaffected.
for LIB in libLiteRt libtfliteextern; do
    chmod u+w lib/$OUT_FOLDER/$LIB.so
    strip --strip-unneeded lib/$OUT_FOLDER/$LIB.so || exit 1
done
# Record the tflite_with_xnnpack define next to the library. The top level CMakeLists.txt reads it
# to set EMGU_TF_LITE_UBUNTU_XNNPACK, and it travels with the binary in the zip package.
echo $TFLITE_WITH_XNNPACK > lib/$OUT_FOLDER/tflite_with_xnnpack.txt

echo Files copied to lib/$OUT_FOLDER
