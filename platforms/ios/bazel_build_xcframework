#!/bin/bash -v

# Builds every iOS native library as a dynamic framework in an xcframework (device arm64 + simulator arm64) in lib/ios/,
# the same split as the macOS and Android builds. Until 2026-11-09 this was three scripts: this one only ran
# bazel_build_tflite_ios_frameworks (the first part), bazel_build_litert_lm_ios was the second, and both sourced
# ios_frameworks.sh.
#
# Usage: bazel_build_xcframework [--without-litert-lm] [extra bazel build arguments]
#   --without-litert-lm  only the first part, leaving any LiteRT-LM xcframeworks as they are. Automatic on an Intel Mac,
#                        where LiteRT-LM can't be built (its Rust crates have no x86_64-apple-darwin host;
#                        docs/native-builds.md, "Not on an Intel Mac").
# The extra arguments go to both parts' bazel build.
#
# First part, LiteRT:
#   lib/ios/LiteRt.xcframework        - LiteRT's runtime (libLiteRt, exporting the LiteRt* and TfLite* C APIs),
#                                       P/Invoked by Emgu.LiteRT
#   lib/ios/tfliteextern.xcframework  - the Emgu TF Lite C wrapper (Emgu.TF.Lite), linked to LiteRt.framework
# Both come from the macOS targets //tfliteextern:litert_runtime and //tfliteextern:tfliteextern_dylib
# (litertextern/tfliteextern/bazel/BUILD), built in the LiteRT-LM workspace against the LiteRT it pins, and are embedded
# by Emgu.LiteRT.Runtime/Maui/iOS (Emgu.LiteRT.runtime.maui.ios). They replace the static libtfliteextern_ios.xcframework
# this script used to build from bazel_build_tflite_ios (removed), which carried its own copy of TFLite.
#
# Second part, LiteRT-LM's C API (Emgu.LiteRT.LM's native library) from the LiteRT-LM submodule, linked to that
# LiteRt.framework instead of carrying its own LiteRT runtime:
#   lib/ios/LiteRtLm.xcframework                       - LiteRT-LM's C API (//c:engine, what //c:litert-lm is built
#                                                        from) with the runtime it exports to omniextern, built with
#                                                        --define=litert_runtime_link_mode=dynamic
#   lib/ios/GemmaModelConstraintProvider.xcframework   - LiteRT-LM's prebuilt Gemma model constraint provider,
#                                                        which it links, wrapped into a framework
#   lib/ios/omniextern.xcframework                     - Emgu's C API over LiteRT-LM's OmniEngine (speech recognition,
#                                                        text to image and speech; litertextern/omniextern, staged
#                                                        into the workspace), linked against LiteRtLm
# Since 2026-11-04 both come from //omniextern_ios (litertextern/omniextern/bazel_ios), two cc_shared_libraries: before,
# //c:litert-lm and //omniextern:omniextern each linked the whole runtime, so omniextern (22.5 MB) duplicated LiteRtLm
# (18.6 MB) and both registered miniaudio's Objective-C class ma_ios_notification_handler, which iOS warned about at
# launch. Now LiteRtLm (29 MB, exporting the runtime) and omniextern (2.4 MB, linking against it) have one copy.
# Both are dynamic frameworks with a device (arm64) and a simulator (arm64) slice. The LiteRT-LM add-on
# Emgu.LiteRT.Runtime/Maui/LM/iOS (Emgu.LiteRT.LM.runtime.maui.ios) embeds them; LiteRt.framework comes from the base
# Emgu.LiteRT.runtime.maui.ios, from the first part, which LiteRtLm links against.
#
# In dynamic mode LiteRT's C API libraries are headers only, and LiteRT links LiteRT-LM against its own libLiteRt.dylib
# - which LiteRT builds for macOS only (a macos_dylib, even in an iOS build), so the linker skips it, and LiteRT-LM's
# .bazelrc (-undefined dynamic_lookup, from its build:macos config, which applies on a macOS host) hides the missing
# library. So the matching slice of our LiteRt.framework is passed to the link (--linkopt), which then binds every
# LiteRt* function to @rpath/LiteRt.framework/LiteRt. As on macOS, TFLite's kernels and XNNPACK, and much of LiteRT's
# runtime, stay inside LiteRT-LM: it calls them through C++ APIs libLiteRt doesn't export.
#
# On iOS LiteRT-LM links prebuilt/ios_{arm64,sim_arm64}/libGemmaModelConstraintProvider.dylib (Git LFS - run
# "git -C LiteRT-LM lfs pull" first), a loose dylib, which an iOS app bundle can't contain, so it is wrapped into
# GemmaModelConstraintProvider.framework. Google builds that prebuilt for iOS 26.4 and later, so LiteRT-LM needs
# iOS 26.4+ at run time even though LiteRtLm.framework targets iOS 15.

WITH_LITERT_LM=1
if [ "$1" = "--without-litert-lm" ]; then
    WITH_LITERT_LM=0
    shift
elif [ "$(uname -m)" = "x86_64" ]; then
    echo "An Intel Mac can't build LiteRT-LM: building LiteRt and tfliteextern only"
    WITH_LITERT_LM=0
fi

cd "$(dirname "$0")/../.."

if command -v python3.12 >/dev/null 2>&1; then
    export HERMETIC_PYTHON_VERSION=3.12
fi

REPO_ROOT=$(pwd)
# Keep Bazel's output tree in a subfolder of this repo, like the other Bazel build scripts.
BAZEL_OUTPUT_USER_ROOT="$REPO_ROOT/bazel_output"
WORKSPACE_DIR=LiteRT-LM
OUT_DIR=lib/ios
mkdir -p $OUT_DIR

# The iOS slices built: Bazel config : xcframework slice folder : CFBundleSupportedPlatforms
IOS_SLICES="ios_arm64:ios-arm64:iPhoneOS ios_sim_arm64:ios-arm64-simulator:iPhoneSimulator"

# Every framework targets the minimum iOS version in cmake/ios_min_version.txt, which the managed projects'
# SupportedOSPlatformVersion also uses (LiteRT-LM's .bazelrc sets 13.0, which the toolchain raises to 14.0).
IOS_MINIMUM_OS="$(tr -d '[:space:]' < cmake/ios_min_version.txt)"

# If Xcode is installed outside /Applications (e.g. on a separate volume), Bazel's sandbox won't use it by default.
XCODE_DEVELOPER_DIR="$(xcode-select -p 2>/dev/null)"
case "$XCODE_DEVELOPER_DIR" in
    /Volumes/*)
        echo "Xcode is on a non-root volume - setting BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1 and DEVELOPER_DIR"
        export BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1
        export DEVELOPER_DIR="$XCODE_DEVELOPER_DIR"
        ;;
esac

# run_bazel <bazel arguments>: runs bazel in the LiteRT-LM workspace.
run_bazel() {
    (cd $WORKSPACE_DIR && bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" "$@")
}

# check_bound <dylib>: fails unless every symbol the dylib imports is bound to a library. LiteRT-LM's .bazelrc links with
# -undefined dynamic_lookup (its build:macos config applies on a macOS host, also to iOS builds), so a missing library
# or symbol doesn't fail the link, only the app at run time.
check_bound() {
    local UNBOUND
    UNBOUND=$(nm -m -u "$1" | grep -v "(from " | grep -v "dyld_stub_binder")
    if [ -n "$UNBOUND" ]; then
        echo "$1 has symbols no library provides:"
        echo "$UNBOUND"
        exit 1
    fi
}

# wrap_framework <dylib> <framework folder> <supported platform> <minimum iOS version>
# Copies a dylib into <framework folder>/<name> (the folder's name without .framework), sets its install name to
# @rpath/<name>.framework/<name>, points its references to the other libraries built here at their frameworks, replaces
# Bazel's rpaths (into its own output folders) with @loader_path/.. - the app's Frameworks folder, where the frameworks
# it depends on are - writes the Info.plist and re-signs it ad hoc (the app build signs it properly).
wrap_framework() {
    local DYLIB=$1 FRAMEWORK=$2 PLATFORM=$3 MIN_OS=$4
    local NAME
    NAME=$(basename "$FRAMEWORK" .framework)
    rm -rf "$FRAMEWORK"
    mkdir -p "$FRAMEWORK"
    cp -f "$DYLIB" "$FRAMEWORK/$NAME" || exit 1
    chmod u+w "$FRAMEWORK/$NAME"
    install_name_tool -id "@rpath/$NAME.framework/$NAME" "$FRAMEWORK/$NAME" || exit 1
    local DEP
    for DEP in libLiteRt:LiteRt libGemmaModelConstraintProvider:GemmaModelConstraintProvider; do
        if otool -L "$FRAMEWORK/$NAME" | grep -q "@rpath/${DEP%%:*}.dylib "; then
            install_name_tool -change "@rpath/${DEP%%:*}.dylib" "@rpath/${DEP##*:}.framework/${DEP##*:}" "$FRAMEWORK/$NAME" || exit 1
        fi
    done
    local RPATH
    for RPATH in $(otool -l "$FRAMEWORK/$NAME" | awk '/cmd LC_RPATH/ {getline; getline; print $2}'); do
        install_name_tool -delete_rpath "$RPATH" "$FRAMEWORK/$NAME" || exit 1
    done
    # Only a library that loads others through @rpath needs the rpath: LiteRT-LM v0.19.0's simulator prebuilt of
    # GemmaModelConstraintProvider loads none and has no room left in its header for another load command.
    if otool -L "$FRAMEWORK/$NAME" | tail -n +2 | grep -v "@rpath/$NAME.framework/$NAME " | grep -q "@rpath/"; then
        install_name_tool -add_rpath @loader_path/.. "$FRAMEWORK/$NAME" || exit 1
    fi
    cat > "$FRAMEWORK/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>$NAME</string>
  <key>CFBundleIdentifier</key>
  <string>com.emgu.litert.$NAME</string>
  <key>CFBundleName</key>
  <string>$NAME</string>
  <key>CFBundlePackageType</key>
  <string>FMWK</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleSupportedPlatforms</key>
  <array>
    <string>$PLATFORM</string>
  </array>
  <key>MinimumOSVersion</key>
  <string>$MIN_OS</string>
</dict>
</plist>
EOF
    codesign -f -s - "$FRAMEWORK/$NAME" || exit 1
}

# ---- First part: LiteRt.xcframework and tfliteextern.xcframework ----

# LiteRT-LM is a pristine third-party submodule (we don't own/patch it upstream), so the tfliteextern Bazel package
# can't live there in git: stage our tracked source into it here instead, each run. Our BUILD file is written for the
# litert workspace, where LiteRT's packages are local (//tflite/..., //litert/...); rewrite those labels to @litert//...
mkdir -p $WORKSPACE_DIR/tfliteextern
sed -e 's#"//tflite#"@litert//tflite#g' -e 's#"//litert#"@litert//litert#g' \
    litertextern/tfliteextern/bazel/BUILD > $WORKSPACE_DIR/tfliteextern/BUILD || exit 1
cp -f litertextern/tfliteextern/bazel/tfliteextern.def litertextern/tfliteextern/bazel/litert_exported_symbols_darwin.lds \
    litertextern/tfliteextern/tfliteextern.cc litertextern/tfliteextern/tfliteextern.h \
    litertextern/imgproc/imgproc.cc litertextern/imgproc/imgproc.h $WORKSPACE_DIR/tfliteextern/ || exit 1

STAGING=$(mktemp -d)
LITERT_ARGS=""
TFLITEEXTERN_ARGS=""
for ENTRY in $IOS_SLICES; do
    IFS=: read CONFIG XCF_SLICE PLATFORM <<< "$ENTRY"
    run_bazel build --verbose_failures -c opt --config=$CONFIG --ios_minimum_os=$IOS_MINIMUM_OS "$@" \
        //tfliteextern:litert_runtime //tfliteextern:tfliteextern_dylib || exit 1
    # bazel-bin follows the most recent build, so each slice is wrapped right after it is built.
    check_bound $WORKSPACE_DIR/bazel-bin/tfliteextern/libLiteRt.dylib
    check_bound $WORKSPACE_DIR/bazel-bin/tfliteextern/libtfliteextern.dylib
    wrap_framework $WORKSPACE_DIR/bazel-bin/tfliteextern/libLiteRt.dylib $STAGING/$XCF_SLICE/LiteRt.framework $PLATFORM $IOS_MINIMUM_OS
    # LiteRT loads its GPU accelerator by name, dlopen("LiteRtMetalAccelerator") (litert/runtime/accelerators/gpu_registry.cc,
    # with no folder set: LiteRT-LM sets none), and dyld looks a bare name up in the caller's rpaths: with this one it finds
    # LiteRtMetalAccelerator.framework (the second part), which apps without it simply don't have.
    install_name_tool -add_rpath @loader_path/../LiteRtMetalAccelerator.framework $STAGING/$XCF_SLICE/LiteRt.framework/LiteRt || exit 1
    codesign -f -s - $STAGING/$XCF_SLICE/LiteRt.framework/LiteRt || exit 1
    wrap_framework $WORKSPACE_DIR/bazel-bin/tfliteextern/libtfliteextern.dylib $STAGING/$XCF_SLICE/tfliteextern.framework $PLATFORM $IOS_MINIMUM_OS
    LITERT_ARGS="$LITERT_ARGS -framework $STAGING/$XCF_SLICE/LiteRt.framework"
    TFLITEEXTERN_ARGS="$TFLITEEXTERN_ARGS -framework $STAGING/$XCF_SLICE/tfliteextern.framework"
done

# Record the TFLite version - TensorFlow's TF_VERSION, from the TensorFlow source Bazel built against - next to the
# libraries. The top level CMakeLists.txt reads it to version the Emgu.TF.Lite packages.
TF_VERSION_BZL="$(run_bazel info output_base)/external/org_tensorflow/tensorflow/tf_version.bzl"
TFLITE_VERSION=$(sed -n 's/^TF_VERSION = "\([0-9][0-9.]*\)".*/\1/p' "$TF_VERSION_BZL")
if [ -n "$TFLITE_VERSION" ]; then
    echo $TFLITE_VERSION > $OUT_DIR/tflite_version.txt
else
    echo "Warning: could not read TF_VERSION from $TF_VERSION_BZL; $OUT_DIR/tflite_version.txt not written"
fi

rm -rf $OUT_DIR/LiteRt.xcframework $OUT_DIR/tfliteextern.xcframework
xcodebuild -create-xcframework $LITERT_ARGS -output $OUT_DIR/LiteRt.xcframework || exit 1
xcodebuild -create-xcframework $TFLITEEXTERN_ARGS -output $OUT_DIR/tfliteextern.xcframework || exit 1
rm -rf $STAGING


if [ $WITH_LITERT_LM = 0 ]; then
    echo Output written to $OUT_DIR/LiteRt.xcframework and $OUT_DIR/tfliteextern.xcframework, without LiteRT-LM
    exit 0
fi

# ---- Second part: LiteRtLm, GemmaModelConstraintProvider, omniextern and LiteRtMetalAccelerator xcframeworks ----

for SLICE in ios_arm64 ios_sim_arm64; do
    for PREBUILT in libGemmaModelConstraintProvider libLiteRtMetalAccelerator; do
        if ! file "$WORKSPACE_DIR/prebuilt/$SLICE/$PREBUILT.dylib" | grep -q Mach-O; then
            echo "$WORKSPACE_DIR/prebuilt/$SLICE/$PREBUILT.dylib is not a Mach-O library (a Git LFS pointer?) - run 'git -C $WORKSPACE_DIR lfs pull'"
            exit 1
        fi
    done
done

# omniextern isn't part of LiteRT-LM: stage our tracked source into its workspace, as the macOS and Android scripts do,
# with the iOS package that builds both frameworks.
mkdir -p $WORKSPACE_DIR/omniextern $WORKSPACE_DIR/omniextern_ios
cp -f litertextern/omniextern/bazel/BUILD $WORKSPACE_DIR/omniextern/BUILD || exit 1
cp -f litertextern/omniextern/omniextern.cc litertextern/omniextern/omniextern.h $WORKSPACE_DIR/omniextern/ || exit 1
cp -f litertextern/omniextern/bazel_ios/BUILD litertextern/omniextern/bazel_ios/static_archives.bzl \
    $WORKSPACE_DIR/omniextern_ios/ || exit 1

STAGING=$(mktemp -d)
LM_ARGS=""
GEMMA_ARGS=""
ASR_ARGS=""
METAL_ARGS=""
for ENTRY in $IOS_SLICES; do
    IFS=: read CONFIG XCF_SLICE PLATFORM <<< "$ENTRY"
    # A copy in a new folder each run: Bazel doesn't track files named only in --linkopt, so a changed path makes it
    # relink against the current LiteRt.framework.
    mkdir -p $STAGING/link/$XCF_SLICE
    cp $OUT_DIR/LiteRt.xcframework/$XCF_SLICE/LiteRt.framework/LiteRt $STAGING/link/$XCF_SLICE/LiteRt || exit 1
    # --platform_suffix keeps this build's outputs apart from the base frameworks' build: the define isn't part of
    # Bazel's output folder name, and in dynamic mode LiteRT's C API libraries would be built empty.
    run_bazel build --verbose_failures -c opt --config=$CONFIG --ios_minimum_os=$IOS_MINIMUM_OS \
        --define=litert_runtime_link_mode=dynamic --platform_suffix=-litert_lm_dynamic \
        --linkopt=$STAGING/link/$XCF_SLICE/LiteRt "$@" //omniextern_ios:litert_lm //omniextern_ios:omniextern || exit 1
    LM_DYLIB=$WORKSPACE_DIR/bazel-bin/omniextern_ios/libLiteRtLm.dylib
    check_bound $LM_DYLIB
    wrap_framework $LM_DYLIB $STAGING/$XCF_SLICE/LiteRtLm.framework $PLATFORM $IOS_MINIMUM_OS
    ASR_DYLIB=$WORKSPACE_DIR/bazel-bin/omniextern_ios/libomniextern.dylib
    check_bound $ASR_DYLIB
    wrap_framework $ASR_DYLIB $STAGING/$XCF_SLICE/omniextern.framework $PLATFORM $IOS_MINIMUM_OS
    ASR_ARGS="$ASR_ARGS -framework $STAGING/$XCF_SLICE/omniextern.framework"
    wrap_framework $WORKSPACE_DIR/prebuilt/$CONFIG/libGemmaModelConstraintProvider.dylib \
        $STAGING/$XCF_SLICE/GemmaModelConstraintProvider.framework $PLATFORM 26.4
    LM_ARGS="$LM_ARGS -framework $STAGING/$XCF_SLICE/LiteRtLm.framework"
    GEMMA_ARGS="$GEMMA_ARGS -framework $STAGING/$XCF_SLICE/GemmaModelConstraintProvider.framework"
    # LiteRT's GPU (Metal) accelerator, Google's prebuilt for iOS 15+: libLiteRt loads it by name from
    # LiteRtMetalAccelerator.framework (see the rpath in the first part).
    wrap_framework $WORKSPACE_DIR/prebuilt/$CONFIG/libLiteRtMetalAccelerator.dylib \
        $STAGING/$XCF_SLICE/LiteRtMetalAccelerator.framework $PLATFORM $IOS_MINIMUM_OS
    METAL_ARGS="$METAL_ARGS -framework $STAGING/$XCF_SLICE/LiteRtMetalAccelerator.framework"
done

# CLiteRTLM.xcframework is what this script built before: LiteRT-LM's own //swift:CLiteRTLM, with its own LiteRT.
rm -rf $OUT_DIR/LiteRtLm.xcframework $OUT_DIR/GemmaModelConstraintProvider.xcframework $OUT_DIR/CLiteRTLM.xcframework \
    $OUT_DIR/omniextern.xcframework $OUT_DIR/LiteRtMetalAccelerator.xcframework
xcodebuild -create-xcframework $LM_ARGS -output $OUT_DIR/LiteRtLm.xcframework || exit 1
xcodebuild -create-xcframework $GEMMA_ARGS -output $OUT_DIR/GemmaModelConstraintProvider.xcframework || exit 1
xcodebuild -create-xcframework $ASR_ARGS -output $OUT_DIR/omniextern.xcframework || exit 1
xcodebuild -create-xcframework $METAL_ARGS -output $OUT_DIR/LiteRtMetalAccelerator.xcframework || exit 1
rm -rf $STAGING

echo Output written to $OUT_DIR/LiteRt.xcframework, $OUT_DIR/tfliteextern.xcframework, $OUT_DIR/LiteRtLm.xcframework, \
    $OUT_DIR/GemmaModelConstraintProvider.xcframework, $OUT_DIR/omniextern.xcframework and $OUT_DIR/LiteRtMetalAccelerator.xcframework
