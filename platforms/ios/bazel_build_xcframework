#!/bin/bash -v

# Builds the iOS natives as dynamic frameworks: lib/ios/LiteRt.xcframework and lib/ios/tfliteextern.xcframework (see
# bazel_build_tflite_ios_frameworks). They replace the static libtfliteextern_ios.xcframework this script used to build
# from bazel_build_tflite_ios, which carried its own copy of TFLite. LiteRT-LM: bazel_build_litert_lm_ios.

"$(dirname "$0")/bazel_build_tflite_ios_frameworks" "$@"
