#!/bin/bash -v

if [ \( -n "$1" \) ]; then
    echo "Building with config $1"
else
    echo "Please specify the ios config and architecture to build. e.g. $0 ios_fat; $0 ios_x86_64; $0 ios_sim_arm64; $0 ios_arm64; $0 ios_armv7; $0 darwin_x86_64"
    exit 1
fi

if [ "$1" = "darwin_x86_64" ] || [ "$1" = "darwin_arm64" ]; then
    echo "Building for Mac Catlyst"
    BAZEL_BUILD_OPTION="--apple_platform_type=macos --cpu=$1 --platforms=@build_bazel_apple_support//platforms:$1"
else
    echo "Building for iOS"
    BAZEL_BUILD_OPTION="--config=$1"
fi

cd "$(dirname "$0")"
cd ../../
# Keep Bazel's output tree (its --output_user_root startup option) in a subfolder of this repo rather than
# the default /private/var/tmp/_bazel_$USER (macOS) or ~/.cache/bazel (Linux). It sits outside the LiteRT-LM/
# workspace on purpose, so Bazel never treats it as source.
BAZEL_OUTPUT_USER_ROOT="$(pwd)/bazel_output"
mkdir -p lib/ios

# If Xcode is installed outside /Applications (e.g. on a separate volume),
# Bazel's sandbox won't mount it by default — add it explicitly.
XCODE_DEVELOPER_DIR="$(xcode-select -p 2>/dev/null)"
XCODE_MOUNT_POINT=""
if [ -n "$XCODE_DEVELOPER_DIR" ]; then
    # If Xcode is under /Volumes/<name>/..., the sandbox mount point is /Volumes/<name>.
    # Paths on the boot volume start with /Applications or similar — no mount needed.
    case "$XCODE_DEVELOPER_DIR" in
        /Volumes/*)
            XCODE_MOUNT_POINT="$(echo "$XCODE_DEVELOPER_DIR" | cut -d/ -f1-3)"
            ;;
    esac
fi

# Map target architecture to Apple SDK platform name (used by XcodeLocalEnvProvider to compute SDKROOT).
case "$1" in
    ios_sim_arm64|ios_x86_64)   APPLE_SDK_PLATFORM="iPhoneSimulator" ;;
    ios_arm64|ios_arm64e|ios_armv7) APPLE_SDK_PLATFORM="iPhoneOS" ;;
    darwin_x86_64|darwin_arm64) APPLE_SDK_PLATFORM="MacOSX" ;;
    *)                          APPLE_SDK_PLATFORM="iPhoneSimulator" ;;
esac

BAZEL_XCODE_OPTS=""
if [ -n "$XCODE_MOUNT_POINT" ] && [ "$XCODE_MOUNT_POINT" != "/" ]; then
    echo "Xcode is on non-root volume: $XCODE_MOUNT_POINT — setting BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1 and DEVELOPER_DIR"
    export BAZEL_ALLOW_NON_APPLICATIONS_XCODE=1
    export DEVELOPER_DIR="$XCODE_DEVELOPER_DIR"
    # XcodeLocalEnvProvider (Bazel Java class) injects SDKROOT into local spawn actions only
    # when APPLE_SDK_VERSION_OVERRIDE is present in the action env.  The apple_env toolchain
    # feature sets it for C++ actions but not ObjC/ObjC++ actions.  Pass it explicitly so
    # ObjC compile actions (e.g. signpost_profiler.mm) also receive SDKROOT.
    XCRUN_SDK=$(echo "$APPLE_SDK_PLATFORM" | tr '[:upper:]' '[:lower:]')
    APPLE_SDK_VERSION=$(xcrun --sdk "$XCRUN_SDK" --show-sdk-version 2>/dev/null)
    BAZEL_XCODE_OPTS="--action_env=DEVELOPER_DIR=$XCODE_DEVELOPER_DIR --action_env=APPLE_SDK_VERSION_OVERRIDE=$APPLE_SDK_VERSION --action_env=APPLE_SDK_PLATFORM=$APPLE_SDK_PLATFORM"
fi

# Build in the LiteRT-LM submodule's Bazel workspace, against the LiteRT it pins (its WORKSPACE fetches LiteRT as
# the external repository @litert), like platforms/macos/bazel_build_tflite_macos and
# platforms/android/bazel_build_tflite_android, so every Bazel build uses the same LiteRT source. LiteRT-LM is a
# pristine third-party submodule (we don't own/patch it upstream), so the tfliteextern Bazel package can't live
# there in git: stage our tracked source into it here instead, each run. Our BUILD file is written for the litert
# workspace, where LiteRT's packages are local (//tflite/..., //litert/...); rewrite those labels to @litert//...
WORKSPACE_DIR=LiteRT-LM
mkdir -p $WORKSPACE_DIR/tfliteextern
sed -e 's#"//tflite#"@litert//tflite#g' -e 's#"//litert#"@litert//litert#g' \
    litertextern/tfliteextern/bazel/BUILD > $WORKSPACE_DIR/tfliteextern/BUILD || exit 1
cp -f litertextern/tfliteextern/bazel/tfliteextern.def $WORKSPACE_DIR/tfliteextern/tfliteextern.def
cp -f litertextern/tfliteextern/tfliteextern.cc $WORKSPACE_DIR/tfliteextern/tfliteextern.cc
cp -f litertextern/tfliteextern/tfliteextern.h $WORKSPACE_DIR/tfliteextern/tfliteextern.h
cp -f litertextern/imgproc/imgproc.cc $WORKSPACE_DIR/tfliteextern/imgproc.cc
cp -f litertextern/imgproc/imgproc.h $WORKSPACE_DIR/tfliteextern/imgproc.h

cd $WORKSPACE_DIR

bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" build \
    --verbose_failures \
    $BAZEL_BUILD_OPTION \
    $BAZEL_XCODE_OPTS \
    -c opt ${@:2} \
    //tfliteextern:tfliteextern_ios_framework || exit 1

# Record the TFLite version - TensorFlow's TF_VERSION, from the TensorFlow source Bazel built against - next to the
# libraries. The top level CMakeLists.txt reads it to version the Emgu.LiteRT.Tflite* nuget packages.
TF_VERSION_BZL="$(bazel --output_user_root="$BAZEL_OUTPUT_USER_ROOT" info output_base)/external/org_tensorflow/tensorflow/tf_version.bzl"
TFLITE_VERSION=$(sed -n 's/^TF_VERSION = "\([0-9][0-9.]*\)".*/\1/p' "$TF_VERSION_BZL")
if [ -n "$TFLITE_VERSION" ]; then
    echo $TFLITE_VERSION > ../lib/ios/tflite_version.txt
else
    echo "Warning: could not read TF_VERSION from $TF_VERSION_BZL; ../lib/ios/tflite_version.txt not written"
fi

cd ..

rm -rf lib/ios/tfliteextern.framework
unzip -o $WORKSPACE_DIR/bazel-bin/tfliteextern/tfliteextern_ios_framework.zip tfliteextern.framework/tfliteextern -d lib/ios
mv lib/ios/tfliteextern.framework/tfliteextern lib/ios/libtfliteextern_$1.a
rm -rf lib/ios/tfliteextern.framework
