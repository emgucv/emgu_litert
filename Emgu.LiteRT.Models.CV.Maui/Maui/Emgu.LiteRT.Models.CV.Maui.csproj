<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Emgu.LiteRT.Models.CV.Maui</AssemblyName>
		<RootNamespace>Emgu.LiteRT.Models.CV.Maui</RootNamespace>
		<LangVersion>latest</LangVersion>
		<!-- As Emgu.LiteRT.LM.Maui. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TfLiteBinaryDir>
		<BaseOutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\</BaseOutputPath>
	</PropertyGroup>

	<Import Project="..\Emgu.LiteRT.Models.CV.Maui.Shared.projitems" Label="Shared" />

	<!--
	Emgu.LiteRT.Models.CV.Maui is the live camera for the Emgu.LiteRT.Models.CV detectors in a MAUI app: frames as Emgu CV Mats
	(Camera2 on Android, with photos and clips; OpenCV's capture elsewhere) and a preview that draws them. Emgu CV's MAUI runtime
	package brings the native OpenCV for each platform and CvImageView, the Android preview; it becomes a nuget package
	dependency when this project is packed, at the version Emgu.LiteRT.Models.CV's Emgu.CV reference uses.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Emgu.CV.runtime.maui.mini" Version="4.12.0.5764" />
	</ItemGroup>
</Project>
