<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>Emgu.TF.Lite.Models</AssemblyName>
	<LangVersion>latest</LangVersion>
	<Configurations>Release;Debug</Configurations>
    <TensorflowBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TensorflowBinaryDir>
	<OutputPath>$(TensorflowBinaryDir)\Build\$(AssemblyName)\$(Platform)\$(Configuration)\</OutputPath>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Emgu.LiteRT.Tflite and Emgu.LiteRT.Util each have their own nuget package now: plain
         ProjectReferences (no PrivateAssets) so this project's package correctly depends on
         both, matching what its code (the Interpreter API, UnmanagedObject) actually uses. -->
    <ProjectReference Include="..\..\Emgu.LiteRT\NetStandard\Emgu.LiteRT.csproj" />
    <ProjectReference Include="..\..\Emgu.LiteRT.Tflite\NetStandard\Emgu.LiteRT.Tflite.csproj" />
    <ProjectReference Include="..\..\Emgu.LiteRT.Util\NetStandard\Emgu.LiteRT.Util.csproj" />
    <ProjectReference Include="..\..\Emgu.LiteRT.ImageIO\NetStandard\Emgu.LiteRT.ImageIO.csproj" />
  </ItemGroup>

  <Import Project="..\Emgu.TF.Lite.Models.Shared.projitems" Label="Shared" />

  <!-- Emgu.Models (NativeImageIO, JpegData, etc.) was renamed to Emgu.LiteRT.ImageIO and made
       its own project+package - this project's code uses its types via the ProjectReference
       above, no direct Shared.projitems import needed here anymore. -->
  <!-- 
  <Target Name="DeployBinary" AfterTargets="AfterBuild">
    <Message Text="Copying $(OutputPath)$(AssemblyName).dll, $(OutputPath)$(AssemblyName).xml to $(TensorflowBinaryDir)" Importance="high" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(TensorflowBinaryDir)" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).xml" DestinationFolder="$(TensorflowBinaryDir)" ContinueOnError="true" />
  </Target>
  -->
</Project>
