<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- <TargetFramework>net9.0-maccatalyst</TargetFramework> -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>	
    <AssemblyName>Emgu.LiteRT.runtime.maui.macos</AssemblyName>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\..\lib))</TfLiteBinaryDir>
    <EmguTfLiteCatalystBinaryDir>$(TfLiteBinaryDir)\runtimes\osx\native</EmguTfLiteCatalystBinaryDir>
    <EmguTfLiteCatalystNativeFile>$(EmguTfLiteCatalystBinaryDir)\libtfliteextern.dylib</EmguTfLiteCatalystNativeFile>
    <EmguLiteRtCatalystNativeFile>$(EmguTfLiteCatalystBinaryDir)\libLiteRt.dylib</EmguLiteRtCatalystNativeFile>
    <EmguTfLiteLinkTarget>MAUI MacCatalyst Library</EmguTfLiteLinkTarget>
    <EmguTfLiteMauiMacErrorMessage Condition="!Exists('$(EmguTfLiteCatalystNativeFile)') Or !Exists('$(EmguLiteRtCatalystNativeFile)')">This package does not contain the native binaries for $(EmguTfLiteLinkTarget): $(EmguTfLiteCatalystNativeFile) or $(EmguLiteRtCatalystNativeFile) is missing - run platforms/macos/bazel_build_tflite_macos_fat.</EmguTfLiteMauiMacErrorMessage>
    <BaseOutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\</BaseOutputPath>
    </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
	
	<Compile Include="$(MSBuildThisFileDirectory)..\iOS\TfLiteInvokeIOS.cs" Link="TfLiteInvokeIOS.cs" />
  </ItemGroup>

    <!-- The macOS libtfliteextern.dylib and the libLiteRt.dylib it links (universal: arm64 and x86_64), from
         platforms/macos/bazel_build_tflite_macos_fat, as on macOS: a Mac Catalyst app can't link a macOS library, but
         it loads one at run time, from Contents/MonoBundle, where DllImport("tfliteextern") and Emgu.LiteRT's
         DllImport("libLiteRt") find them - the same way it loads LiteRT-LM's macOS dylibs (Emgu.LiteRT.LM.runtime.maui.macos).
         Until 2026-11-09 Catalyst had its own static tfliteextern (platforms/ios/cmake_build_tflite_catalyst), with a
         second copy of TFLite, without XNNPACK, and no libLiteRt unless the LiteRT-LM add-on was there. -->
    <ItemGroup Condition="Exists('$(EmguTfLiteCatalystNativeFile)') And Exists('$(EmguLiteRtCatalystNativeFile)')">
      <None Include="$(EmguTfLiteCatalystNativeFile);$(EmguLiteRtCatalystNativeFile)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Pack>True</Pack>
        <PackagePath>runtimes\maccatalyst-arm64\native;runtimes\maccatalyst-x64\native</PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
      <!-- Emgu.TF.Lite and Emgu.LiteRT.Util each have their own nuget package now: plain
           ProjectReferences (no PrivateAssets) so this project's package depends on all three. -->
      <ProjectReference Include="..\..\..\Emgu.LiteRT\NetStandard\Emgu.LiteRT.csproj" />
      <ProjectReference Include="..\..\..\Emgu.TF.Lite\NetStandard\Emgu.TF.Lite.csproj" />
      <ProjectReference Include="..\..\..\Emgu.LiteRT.Util\NetStandard\Emgu.LiteRT.Util.csproj" />
    </ItemGroup>
  <Target Name="DeployBinary" AfterTargets="AfterBuild">
    <Warning Text="'$(EmguTfLiteMauiMacErrorMessage)'" Condition="'$(EmguTfLiteMauiMacErrorMessage)'!=''" />
  </Target>
</Project>
