<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoBindingEmbedding>true</NoBindingEmbedding>
  </PropertyGroup>
  <PropertyGroup>
    <TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\..\lib))</TfLiteBinaryDir>
    <EmguLiteRtIOSFramework>$(TfLiteBinaryDir)\ios\LiteRt.xcframework</EmguLiteRtIOSFramework>
    <EmguTfLiteIOSFramework>$(TfLiteBinaryDir)\ios\tfliteextern.xcframework</EmguTfLiteIOSFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <WarningLevel>4</WarningLevel>
    <OutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\$(Configuration)\</OutputPath>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchHttpClientHandler>HttpClientHandler</MtouchHttpClientHandler>
    <!-- <PlatformTarget>anycpu</PlatformTarget> -->
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\$(Configuration)\</OutputPath>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchHttpClientHandler>HttpClientHandler</MtouchHttpClientHandler>
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>
   
  <ItemGroup>
    <!-- Dynamic frameworks built by platforms/ios/bazel_build_tflite_ios_frameworks, the same split as the macOS and
         Android libraries: LiteRt.framework is LiteRT's runtime (the LiteRt* and TfLite* C APIs, P/Invoked by
         Emgu.LiteRT), and tfliteextern.framework the Emgu TF Lite wrapper (Emgu.TF.Lite), linked to it. LiteRT-LM's
         framework (the Emgu.LiteRT.LM.runtime.maui.ios add-on) is linked to it too. The DllImports name them by path
         (@rpath/<name>.framework/<name>). -->
    <NativeReference Condition="Exists('$(EmguLiteRtIOSFramework)')" Include="$(EmguLiteRtIOSFramework)">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Condition="Exists('$(EmguTfLiteIOSFramework)')" Include="$(EmguTfLiteIOSFramework)">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

    <ItemGroup>
      <!-- Emgu.TF.Lite and Emgu.LiteRT.Util each have their own nuget package now: plain
           ProjectReferences (no PrivateAssets) so this project's package depends on all three. -->
      <ProjectReference Include="..\..\..\Emgu.LiteRT\NetStandard\Emgu.LiteRT.csproj" />
      <ProjectReference Include="..\..\..\Emgu.TF.Lite\NetStandard\Emgu.TF.Lite.csproj" />
      <ProjectReference Include="..\..\..\Emgu.LiteRT.Util\NetStandard\Emgu.LiteRT.Util.csproj" />
    </ItemGroup>
	  
  <Target Name="EmguTfLiteMauiIOSPackageBuildImports" BeforeTargets="PrepareForBuild">
    <Message Text="iOS frameworks embedded: '$(EmguLiteRtIOSFramework)', '$(EmguTfLiteIOSFramework)'" Importance="high" Condition="Exists('$(EmguLiteRtIOSFramework)') And Exists('$(EmguTfLiteIOSFramework)')" />
    <Warning Text="The iOS native frameworks are missing ($(EmguLiteRtIOSFramework), $(EmguTfLiteIOSFramework)) - run platforms/ios/bazel_build_tflite_ios_frameworks." Condition="!Exists('$(EmguLiteRtIOSFramework)') Or !Exists('$(EmguTfLiteIOSFramework)')" />
  </Target>
</Project>
