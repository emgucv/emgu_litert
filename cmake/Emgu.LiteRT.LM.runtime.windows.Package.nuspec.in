<?xml version="1.0"?>
<package >
  <metadata>
    <id>${EMGUTF_LITERT_LM_WINDOWS_NUGET_ID}</id>
	<title>${EMGUTF_LITERT_LM_WINDOWS_NUGET_TITLE}</title>
    <version>${EMGUTF_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
    <license type="file">${EMGUTF_LICENSE_FILE}</license>
    <projectUrl>${EMGUTF_MAIN_WEB_URL}</projectUrl>
	<repository type="git" url="https://github.com/emgucv/emgutf" />
	<icon>icon.png</icon>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
	<summary>Runtime package of liblitert-lm (LiteRT-LM's C API) for Windows</summary>
    <description>This package contains liblitert-lm.dll, LiteRT-LM's C API runtime used by Emgu.LiteRT.LM, for Windows, together with its prebuilt libGemmaModelConstraintProvider.dll dependency. It depends on ${EMGUTF_LITE_WINDOWS_NUGET_ID} (libLiteRt.dll), which it links against dynamically.</description>
    <releaseNotes>This is the ${EMGUTF_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu LiteRT LM for Windows, built on LiteRT-LM ${LITERT_LM_VERSION}, part of the ${CPACK_PACKAGE_VERSION} release of Emgu LiteRT. For online documentation please visit
http://www.emgu.com/wiki/files/emgutf/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document-lite/</releaseNotes>
    <readme>docs/README.md</readme>
	${EMGUTF_LITERT_LM_WINDOWS_NUGET_DEPENDENCY}
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>
    <tags>tensorflow lite emgu emgutf ai litert-lm</tags>
  </metadata>
  <files>
  ${EMGUTF_LITERT_LM_WINDOWS_NUGET_FILE_LIST}
  </files>
</package>
