<?xml version="1.0"?>
<package >
  <metadata>
    <id>${EMGU_TFLITE_DEBIAN_NUGET_ID}</id>
	<title>${EMGU_TFLITE_DEBIAN_NUGET_TITLE}</title>
    <version>${EMGU_TFLITE_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
    <license type="file">${EMGU_LITERT_LICENSE_FILE}</license>
    <projectUrl>${EMGUTF_MAIN_WEB_URL}</projectUrl>
	<repository type="git" url="${GITHUB_REPO_URL}" />
	<icon>icon.png</icon>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
	<summary>${DEBIAN_LITE_ARCH_UPPER} runtime package of tfliteextern (Emgu TF Lite's TensorFlow Lite C API wrapper) for Debian (including Raspberry Pi OS)</summary>
    <description>This package contains libtfliteextern.so, the native TensorFlow Lite Interpreter C API wrapper used by Emgu.TF.Lite, for Debian (including Raspberry Pi OS), ${DEBIAN_LITE_RELEASE_ARCH_ID}. The Bazel build links it against libLiteRt.so (which contains TensorFlow Lite itself), in ${EMGU_LITERT_DEBIAN_NUGET_ID_FOR_TFLITE}, which Emgu.LiteRT's CompiledModel API P/Invokes directly.</description>
    <releaseNotes>This is the ${EMGU_TFLITE_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu TF Lite for ${DEBIAN_LITE_ARCH_UPPER} Debian (including Raspberry Pi OS), built on TensorFlow Lite ${EMGU_TFLITE_VERSION}, part of the ${CPACK_PACKAGE_VERSION} release of Emgu LiteRT. For online documentation please visit
http://www.emgu.com/wiki/files/emgutf/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document-lite/</releaseNotes>
    <readme>docs/README.md</readme>
	${EMGU_TFLITE_DEBIAN_NUGET_DEPENDENCY}
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>
    <tags>tensorflow lite emgu emgutf ai raspberrypi</tags>
  </metadata>
  <files>
  ${EMGU_TFLITE_DEBIAN_NUGET_FILE_LIST}
  </files>
</package>
