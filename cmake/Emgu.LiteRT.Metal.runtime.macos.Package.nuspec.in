<?xml version="1.0"?>
<package >
  <metadata>
    <id>${EMGU_LITERT_METAL_MACOS_NUGET_ID}</id>
	<title>${EMGU_LITERT_METAL_MACOS_NUGET_TITLE}</title>
    <version>${CPACK_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
    <license type="file">${EMGU_LITERT_LICENSE_FILE}</license>
    <projectUrl>${EMGUTF_MAIN_WEB_URL}</projectUrl>
    <repository type="git" url="${GITHUB_REPO_URL}" />
	<icon>icon.png</icon>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
	<summary>Optional GPU (Metal) accelerator of Emgu LiteRT for Mac OS console or asp.net applications (not for MAUI)</summary>
    <description>LiteRT's GPU (Metal) accelerator plugin, libLiteRtMetalAccelerator.dylib, for Mac OS console or asp.net applications on Apple Silicon (macOS 14+; not for MAUI - use ${EMGU_LITERT_METAL_MAUI_MACOS_NUGET_ID} there): lets LiteRT-LM run models on the Mac's GPU. Optional; depends on ${EMGU_LITERT_MACOS_NUGET_ID}, whose libLiteRt.dylib loads it.</description>
    <releaseNotes>This is the GPU (Metal) accelerator of Emgu LiteRT for Mac OS, part of the ${CPACK_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu LiteRT. For online documentation please visit
http://www.emgu.com/wiki/files/emgutf/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document-lite/</releaseNotes>
    <readme>docs/README.md</readme>
	${EMGU_LITERT_METAL_MACOS_NUGET_DEPENDENCY}
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>
    <tags>tensorflow lite emgu emgutf ai litert litert-lm gpu metal macos</tags>
  </metadata>
  <files>
  ${EMGU_LITERT_METAL_MACOS_NUGET_FILE_LIST}
  </files>
</package>
