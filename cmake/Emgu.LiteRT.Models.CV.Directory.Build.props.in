<?xml version="1.0"?>
<Project>
 <PropertyGroup>
 
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
	<!-- Don't build for iOS or Maccatalyst on Linux -->
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-ios;net${DOTNET_VERSION_MAJOR}.0-android;net${DOTNET_VERSION_MAJOR}.0-maccatalyst</TargetFrameworks>

    <PackageId>${EMGU_LITERT_MODELS_CV_NUGET_ID}</PackageId>
	<title>${EMGU_LITERT_MODELS_CV_NUGET_TITLE}</title>
    <version>${CPACK_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
	<summary>Emgu CV based image input for Emgu LiteRT models: YOLOX, PicoDet, D-FINE, COCO SSD, MediaPipe hands and pose detectors, and Mat input for MobileNet and Inception</summary>
    <Description>Ready-to-use detectors that take Emgu CV images (Mat): COCO SSD MobileNet V3, YOLOX-Nano, PicoDet-S, D-FINE-N, MediaPipe hand gestures and body pose, running on LiteRT (Emgu.LiteRT.Models) with a checked GPU path where the platform has one, plus Mat input for the Interpreter-based MobileNet and Inception (Emgu.TF.Lite.Models). Needs an Emgu CV runtime package.</Description>
    <PackageReleaseNotes>This is the ${CPACK_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu LiteRT Models CV, part of the ${CPACK_PACKAGE_VERSION} release of Emgu LiteRT. For online documentation please visit
${NUGET_EMGU_URL}/wiki/files/emgutf/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document-lite/index.html</PackageReleaseNotes>
	
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageIcon>nuget_icon.png</PackageIcon>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<RepositoryUrl>${GITHUB_REPO_URL}</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\platforms\nuget))</PackageOutputPath>
	<PackageTags>tensorflow litert emgu emgutf emgucv ai yolox picodet dfine mediapipe detection</PackageTags>
    <PackageProjectUrl>${NUGET_EMGU_URL}</PackageProjectUrl>
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>
    
 </PropertyGroup>
 
    <ItemGroup>
      <None Include="..\..\LICENSE.txt">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="..\..\miscellaneous\nuget_icon.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
      <None Include="docs\README.md">
        <Pack>True</Pack>
        <PackagePath>docs\</PackagePath>
      </None>
    </ItemGroup>
	
  <!-- https://learn.microsoft.com/en-us/visualstudio/msbuild/customize-by-directory?view=vs-2022 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <Import Project="SignBinary.Targets" Condition="exists('SignBinary.Targets')" />	
  <Import Project="SignPkg.Targets" Condition="exists('SignPkg.Targets')" />	
</Project>