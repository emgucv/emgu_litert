<?xml version="1.0"?>
<Project>
  <!-- https://learn.microsoft.com/en-us/visualstudio/msbuild/customize-by-directory?view=vs-2022 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>

	<TargetFrameworks>net${DOTNET_VERSION_MAJOR}.0-android;net${DOTNET_VERSION_MAJOR}.0-ios</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-maccatalyst</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-windows10.0.19041.0</TargetFrameworks>

	<MauiVersion Condition="'$(MauiVersion)' == ''">${DOTNET_VERSION_MAJOR}.0.0</MauiVersion>

    <EmguLiteRTProjectRoot>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\))</EmguLiteRTProjectRoot>

    <PackageId>${EMGU_LITERT_LM_MAUI_CLAUDE_NUGET_ID}</PackageId>
	<title>${EMGU_LITERT_LM_MAUI_CLAUDE_NUGET_TITLE}</title>
    <version>${EMGU_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
	<summary>Anthropic's Claude models for the Emgu LiteRT LM MAUI chat page: Claude through the Claude API, with your API key, as the chat's remote model option.</summary>
    <Description>The ClaudeFeature of the Emgu LiteRT LM MAUI chat page (ChatPage): Anthropic's Claude models through the Claude API and its official C# SDK, in place of a model on the device, chatting through the same agent, tools, saved chats and compaction, with Claude's thinking shown and the conversation cached between messages. The settings section takes an API key from the Claude Console, kept in secure storage, and one of the models it can use. Android, iOS, Mac Catalyst and Windows.</Description>
    <PackageReleaseNotes>This is the ${EMGU_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu LiteRT LM MAUI Claude, part of the ${CPACK_PACKAGE_VERSION} release of Emgu LiteRT. For online documentation please visit
http://www.emgu.com/wiki/files/emgutflite/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document/</PackageReleaseNotes>

	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageIcon>nuget_icon.png</PackageIcon>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<RepositoryUrl>${GITHUB_REPO_URL}</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$([System.IO.Path]::GetFullPath($(EmguLiteRTProjectRoot)\platforms\nuget))</PackageOutputPath>
	<PackageTags>litert litert-lm llm gemma chat maui claude anthropic emgu emgutflite ai</PackageTags>
    <PackageProjectUrl>${NUGET_EMGU_URL}</PackageProjectUrl>
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>

  </PropertyGroup>

    <ItemGroup>
      <None Include="$(EmguLiteRTProjectRoot)\LICENSE.txt">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="$(EmguLiteRTProjectRoot)\miscellaneous\nuget_icon.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
      <None Include="docs\README.md">
        <Pack>True</Pack>
        <PackagePath>docs\</PackagePath>
      </None>
    </ItemGroup>

  <Import Project="SignBinary.Targets" Condition="exists('SignBinary.Targets')" />
  <Import Project="SignPkg.Targets" Condition="exists('SignPkg.Targets')" />
</Project>
