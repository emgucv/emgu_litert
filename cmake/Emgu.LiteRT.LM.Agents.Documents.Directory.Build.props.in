<?xml version="1.0"?>
<Project>
 <PropertyGroup>
 
    <!-- Managed code: netstandard2.0 for any .NET, net8.0 for current runtimes, as Emgu.LiteRT.LM.Agents. -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
 
    <PackageId>${EMGU_LITERT_LM_AGENTS_DOCUMENTS_NUGET_ID}</PackageId>
	<title>${EMGU_LITERT_LM_AGENTS_DOCUMENTS_NUGET_TITLE}</title>
    <version>${EMGU_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
	<summary>Document questions for chat agents: reads PDF, Word and text files into text passages and pictures (PdfPig), and ranks saved passages for a search over the user's documents.</summary>
    <Description>Reads documents for a chat agent's questions about them: PDF (text per page and pictures with PdfPig; pages without text as images through a platform renderer such as Emgu.LiteRT.LM.Maui's PdfPageRenderer), Word (.docx: text and pictures) and text files, for Emgu.LiteRT.LM.Models' DocumentIndex and vision models. Also ranks passages an app saved from them, for Emgu.LiteRT.LM.Agents' search_documents tool, and formats them as quoted data. Pure managed code.</Description>
    <PackageReleaseNotes>This is the ${EMGU_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu LiteRT LM Agents Documents, part of the ${CPACK_PACKAGE_VERSION} release of Emgu LiteRT. For online documentation please visit
http://www.emgu.com/wiki/files/emgutflite/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document/</PackageReleaseNotes>
	
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageIcon>nuget_icon.png</PackageIcon>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<RepositoryUrl>${GITHUB_REPO_URL}</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\platforms\nuget))</PackageOutputPath>
	<PackageTags>litert litert-lm llm agent documents pdf docx rag search emgu emgutflite ai</PackageTags>
    <PackageProjectUrl>${NUGET_EMGU_URL}</PackageProjectUrl>
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>
    
 </PropertyGroup>
 
    <ItemGroup>
      <None Include="..\..\LICENSE.txt">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="..\..\miscellaneous\nuget_icon.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
      <None Include="docs\README.md">
        <Pack>True</Pack>
        <PackagePath>docs\</PackagePath>
      </None>
    </ItemGroup>
	
  <!-- https://learn.microsoft.com/en-us/visualstudio/msbuild/customize-by-directory?view=vs-2022 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <Import Project="SignBinary.Targets" Condition="exists('SignBinary.Targets')" />	
  <Import Project="SignPkg.Targets" Condition="exists('SignPkg.Targets')" />	 
</Project>