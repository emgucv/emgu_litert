<?xml version="1.0"?>
<Project>
  <PropertyGroup>
  	<TargetFrameworks>net${DOTNET_VERSION_MAJOR}.0-android</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-ios${IOS_TFM_VERSION};net${DOTNET_VERSION_MAJOR}.0-maccatalyst${IOS_TFM_VERSION}</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-windows10.0.22621.0</TargetFrameworks>
	<!-- From cmake/ios_min_version.txt, shared with the native iOS build. -->
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">${EMGU_LITERT_IOS_MIN_VERSION}</SupportedOSPlatformVersion>
    ${MAUI_VERSION_MSBUILD}
    <WindowsGpuRuntimePackageVersion>${CPACK_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</WindowsGpuRuntimePackageVersion>
  </PropertyGroup>
</Project>
