<?xml version="1.0"?>
<Project>
  <!-- https://learn.microsoft.com/en-us/visualstudio/msbuild/customize-by-directory?view=vs-2022 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>

	<TargetFrameworks>net${DOTNET_VERSION_MAJOR}.0-android;net${DOTNET_VERSION_MAJOR}.0-ios${IOS_TFM_VERSION}</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx')) or $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-maccatalyst${IOS_TFM_VERSION}</TargetFrameworks>
	<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net${DOTNET_VERSION_MAJOR}.0-windows10.0.19041.0</TargetFrameworks>
	<!-- From cmake/ios_min_version.txt, shared with the native iOS build. -->
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">${EMGU_LITERT_IOS_MIN_VERSION}</SupportedOSPlatformVersion>

	<MauiVersion Condition="'$(MauiVersion)' == ''">${DOTNET_VERSION_MAJOR}.0.0</MauiVersion>

    <EmguLiteRTProjectRoot>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\))</EmguLiteRTProjectRoot>

    <PackageId>${EMGU_LITERT_LM_MAUI_APPLE_NUGET_ID}</PackageId>
	<title>${EMGU_LITERT_LM_MAUI_APPLE_NUGET_TITLE}</title>
    <version>${EMGU_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX}</version>
    <authors>${CPACK_PACKAGE_VENDOR}</authors>
    <owners>${CPACK_PACKAGE_VENDOR}</owners>
	<summary>Apple Intelligence for the Emgu LiteRT LM MAUI chat page: Apple's on-device model (Foundation Models) as the chat's remote model option.</summary>
    <Description>The AppleIntelligenceFeature of the Emgu LiteRT LM MAUI chat page (ChatPage): Apple's on-device language model (the Foundation Models framework, Apple Intelligence) in place of a model of the app's own, chatting through the same agent, saved chats and compaction, over Microsoft.Maui.Essentials.AI's IChatClient. Nothing is downloaded and nothing leaves the device; it needs iOS 26 or macOS 26 or later on a device with Apple Intelligence turned on. iOS and Mac Catalyst (the other platforms build, without the model).</Description>
    <PackageReleaseNotes>This is the ${EMGU_LITERT_LM_PACKAGE_VERSION}${TENSORFLOW_VERSION_SUFFIX} release of Emgu LiteRT LM MAUI Apple, part of the ${CPACK_PACKAGE_VERSION} release of Emgu LiteRT. For online documentation please visit
http://www.emgu.com/wiki/files/emgutflite/${CPACK_PACKAGE_VERSION_MAJOR}.${CPACK_PACKAGE_VERSION_MINOR}.${CPACK_PACKAGE_VERSION_PATCH}/document/</PackageReleaseNotes>

	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageIcon>nuget_icon.png</PackageIcon>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<RepositoryUrl>${GITHUB_REPO_URL}</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
	<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageOutputPath>$([System.IO.Path]::GetFullPath($(EmguLiteRTProjectRoot)\platforms\nuget))</PackageOutputPath>
	<PackageTags>litert litert-lm llm gemma chat maui apple apple-intelligence foundation-models emgu emgutflite ai</PackageTags>
    <PackageProjectUrl>${NUGET_EMGU_URL}</PackageProjectUrl>
    <copyright>© ${CPACK_PACKAGE_VENDOR} ${CURRENT_YEAR}. All rights reserved.</copyright>

  </PropertyGroup>

    <ItemGroup>
      <None Include="$(EmguLiteRTProjectRoot)\LICENSE.txt">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
      <None Include="$(EmguLiteRTProjectRoot)\miscellaneous\nuget_icon.png">
        <Pack>True</Pack>
        <PackagePath></PackagePath>
      </None>
    </ItemGroup>
    <ItemGroup>
      <None Include="docs\README.md">
        <Pack>True</Pack>
        <PackagePath>docs\</PackagePath>
      </None>
    </ItemGroup>

  <Import Project="SignBinary.Targets" Condition="exists('SignBinary.Targets')" />
  <Import Project="SignPkg.Targets" Condition="exists('SignPkg.Targets')" />
</Project>
