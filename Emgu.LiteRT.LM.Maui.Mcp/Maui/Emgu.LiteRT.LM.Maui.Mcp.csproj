<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Emgu.LiteRT.LM.Maui.Mcp</AssemblyName>
		<RootNamespace>Emgu.LiteRT.LM.Maui.Mcp</RootNamespace>
		<LangVersion>latest</LangVersion>
		<!-- iOS 15 and Mac Catalyst 15, as Emgu.LiteRT.LM.Maui. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TfLiteBinaryDir>
		<BaseOutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\</BaseOutputPath>
	</PropertyGroup>

	<Import Project="..\Emgu.LiteRT.LM.Maui.Mcp.Shared.projitems" Label="Shared" />

	<!--
	Emgu.LiteRT.LM.Maui.Mcp is ChatPage's McpFeature: Model Context Protocol tool servers the user adds in the settings, each
	a tool group of the chat's agent. Kept out of Emgu.LiteRT.LM.Maui so that package doesn't depend on
	Emgu.LiteRT.LM.Agents.Mcp and the MCP SDK.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Maui\Maui\Emgu.LiteRT.LM.Maui.csproj" />
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Agents.Mcp\NetStandard\Emgu.LiteRT.LM.Agents.Mcp.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>
</Project>
