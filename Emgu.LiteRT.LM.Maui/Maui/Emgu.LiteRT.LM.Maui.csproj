<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Emgu.LiteRT.LM.Maui</AssemblyName>
		<RootNamespace>Emgu.LiteRT.LM.Maui</RootNamespace>
		<LangVersion>latest</LangVersion>
		<!-- iOS 15 and Mac Catalyst 15, as the LiteRT frameworks; LiteRT-LM itself needs iOS 26.4 at run time. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TfLiteBinaryDir>
		<BaseOutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\</BaseOutputPath>
	</PropertyGroup>

	<Import Project="..\Emgu.LiteRT.LM.Maui.Shared.projitems" Label="Shared" />

	<!--
	Emgu.LiteRT.LM.Maui is a MAUI chat control (ChatView) built with XAML templates, so apps can restyle it, on top of
	Emgu.LiteRT.LM.Chat's conversation logic. It has no native runtime dependency: the app adds the LiteRT-LM runtime
	packages it wants, as for Emgu.LiteRT.LM.Models. The reference becomes a nuget package dependency when this project is
	packed.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Chat\NetStandard\Emgu.LiteRT.LM.Chat.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>
</Project>
