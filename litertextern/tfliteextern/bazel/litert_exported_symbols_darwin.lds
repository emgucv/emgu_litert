# Symbols exported by the macOS libLiteRt.dylib built by //tfliteextern:litert_runtime: LiteRT's own C API
# plus the TensorFlow Lite C API, which tfliteextern links against. Same patterns as LiteRT's
# //litert/build_common:export_litert_tflite_runtime_darwin.lds, which isn't visible outside //litert.
_LiteRt*
_TfLite*
_kLiteRtRuntimeBuiltin
