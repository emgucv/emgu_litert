<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>Emgu.LiteRT.LM.Server</AssemblyName>
	<TargetName>$(AssemblyName)</TargetName>
	<Platforms>AnyCPU;x64;x86;ARM</Platforms>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TensorflowBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TensorflowBinaryDir>
	<OutputPath>$(TensorflowBinaryDir)\Build\$(AssemblyName)\$(Platform)\$(Configuration)\</OutputPath>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <Import Project="..\Emgu.LiteRT.LM.Server.Shared.projitems" Label="Shared" />

  <!--
  Emgu.LiteRT.LM.Server serves any Microsoft.Extensions.AI IChatClient - a LiteRT-LM model on a Mac - over an OpenAI-compatible
  HTTP API on the local network (System.Net.HttpListener: no ASP.NET Core, which a Mac Catalyst app can't use), with phones paired
  by a code. It needs no LiteRT itself.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
  </ItemGroup>

  <!-- The tests check the protocol's helpers directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Emgu.TF.Lite.Test.Net" />
  </ItemGroup>
</Project>
