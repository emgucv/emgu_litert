<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Emgu.LiteRT.LM.Maui.OpenAI</AssemblyName>
		<RootNamespace>Emgu.LiteRT.LM.Maui.OpenAI</RootNamespace>
		<LangVersion>latest</LangVersion>
		<!-- iOS 15 and Mac Catalyst 15, as Emgu.LiteRT.LM.Maui. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<!-- .NET 11 for Android supports Android 7.0 (API 24) and later (XA4216). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), 11.0))">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TfLiteBinaryDir>
		<BaseOutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\</BaseOutputPath>
	</PropertyGroup>

	<Import Project="..\Emgu.LiteRT.LM.Maui.OpenAI.Shared.projitems" Label="Shared" />

	<!--
	Emgu.LiteRT.LM.Maui.OpenAI is ChatPage's ServerFeature: a model on a server of the user's own (LM Studio, Ollama,
	llama.cpp, vLLM, or a Mac running this app) through its OpenAI-compatible API, as the chat's remote model option; and
	ServeModelsFeature, the other side: a Mac serving its chat's model to phones (Emgu.LiteRT.LM.Server). Kept out of
	Emgu.LiteRT.LM.Maui so that package doesn't depend on Microsoft.Extensions.AI.OpenAI and the OpenAI SDK.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Maui\Maui\Emgu.LiteRT.LM.Maui.csproj" />
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Server\NetStandard\Emgu.LiteRT.LM.Server.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- 10.10.1 turns the servers' reasoning_content into TextReasoningContent, so thinking shows as it does for local models. -->
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
	</ItemGroup>
</Project>
