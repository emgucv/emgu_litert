<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Emgu.LiteRT.LM.Maui.Apple</AssemblyName>
		<RootNamespace>Emgu.LiteRT.LM.Maui.Apple</RootNamespace>
		<LangVersion>latest</LangVersion>
		<!-- iOS 15 and Mac Catalyst 15, as Emgu.LiteRT.LM.Maui. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<!-- .NET 11 for Android supports Android 7.0 (API 24) and later (XA4216). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), 11.0))">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<!-- Microsoft.Maui.Essentials.AI's APIs are experimental (one diagnostic id for all of them). -->
		<NoWarn>$(NoWarn);MAUIAI0001</NoWarn>
		<TfLiteBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TfLiteBinaryDir>
		<BaseOutputPath>$(TfLiteBinaryDir)\Build\$(AssemblyName)\$(Platform)\</BaseOutputPath>
	</PropertyGroup>

	<Import Project="..\Emgu.LiteRT.LM.Maui.Apple.Shared.projitems" Label="Shared" />

	<!--
	Emgu.LiteRT.LM.Maui.Apple is ChatPage's AppleIntelligenceFeature: Apple's on-device model (Foundation Models), as the chat's
	remote model option. Kept out of Emgu.LiteRT.LM.Maui so that package doesn't depend on Microsoft.Maui.Essentials.AI.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\Emgu.LiteRT.LM.Maui\Maui\Emgu.LiteRT.LM.Maui.csproj" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- AppleIntelligenceChatClient, an IChatClient over Apple's Foundation Models (iOS 26 / macOS 26 and later with Apple
		     Intelligence). Only the Apple targets use it (the package's Android and Windows clients are other models). -->
		<PackageReference Include="Microsoft.Maui.Essentials.AI" Version="11.0.0-preview.8.26555.2"
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
	</ItemGroup>
</Project>
