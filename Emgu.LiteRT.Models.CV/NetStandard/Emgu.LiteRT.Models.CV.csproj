<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<AssemblyName>Emgu.LiteRT.Models.CV</AssemblyName>
	<LangVersion>latest</LangVersion>
	<ImplicitUsings>enable</ImplicitUsings>
	<Configurations>Release;Debug</Configurations>
    <TensorflowBinaryDir>$([System.IO.Path]::GetFullPath($(MSBuildThisFileDirectory)..\..\lib))</TensorflowBinaryDir>
	<OutputPath>$(TensorflowBinaryDir)\Build\$(AssemblyName)\$(Platform)\$(Configuration)\</OutputPath>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The models these helpers drive: Emgu.LiteRT.Models' CompiledModel classes, and Emgu.TF.Lite.Models' Interpreter-based
         Mobilenet/Inception. Plain ProjectReferences, so the package depends on them. -->
    <ProjectReference Include="..\..\Emgu.LiteRT\NetStandard\Emgu.LiteRT.csproj" />
    <ProjectReference Include="..\..\Emgu.LiteRT.Util\NetStandard\Emgu.LiteRT.Util.csproj" />
    <ProjectReference Include="..\..\Emgu.TF.Lite\NetStandard\Emgu.TF.Lite.csproj" />
    <ProjectReference Include="..\..\Emgu.LiteRT.Models\NetStandard\Emgu.LiteRT.Models.csproj" />
    <ProjectReference Include="..\..\Emgu.TF.Lite.Models\NetStandard\Emgu.TF.Lite.Models.csproj" />
  </ItemGroup>

  <!-- Emgu CV's managed library only: an app adds the Emgu CV runtime package for its platform (Emgu.CV.runtime.*), at the
       same version. netstandard2.0 uses the version Emgu.TF.Lite.ImageIO's netstandard2.0 build already depends on (a lower
       one would be a package downgrade); the iOS/Android/Mac Catalyst builds use the MAUI demo's Emgu.CV.runtime.maui.mini
       version, since a higher managed version would run against its older native library. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Emgu.CV" Version="4.13.0.5924" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <PackageReference Include="Emgu.CV" Version="4.12.0.5764" />
  </ItemGroup>

  <!-- The tests drive the image input helpers and the CPU/GPU benchmark directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Emgu.TF.Lite.Test.Net" />
  </ItemGroup>

  <Import Project="..\Emgu.LiteRT.Models.CV.Shared.projitems" Label="Shared" />
</Project>
